# Local development defaults. For production use:
# NODE_ENV=production
# APP_ENV=production
# BILLING_MODE=live
# PAYMENTS_DISABLED=false
NODE_ENV=development
APP_ENV=demo
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/museus
DIRECT_URL=postgresql://user:pass@localhost:5432/museus

# Auth and cookies
# In production use random values with 32+ characters.
JWT_SECRET=change-me-use-at-least-32-characters
REFRESH_SECRET=change-me-use-at-least-32-characters
COOKIE_SECRET=change-me-use-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_SAME_SITE=lax

# Queues/cache
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payments
BILLING_MODE=disabled
PAYMENTS_DISABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SPONSOR_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PROVIDER=

# Gamification
GAME_SECRET=change-me-use-at-least-32-characters

# Email
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MASTER_ALERT_EMAIL=

# Uploads / storage
UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Media processing
COMPRESSION_QUALITY=80
MAX_IMAGE_WIDTH=1920

# Optional integrations
ASAAS_API_KEY=

{
    "compilerOptions":  {
                            "target":  "ES2019",
                            "module":  "CommonJS",
                            "moduleResolution":  "Node",
                            "outDir":  "dist",
                            "rootDir":  "src",
                            "esModuleInterop":  true,
                            "strict":  true,
                            "noImplicitAny":  true,
                            "skipLibCheck":  true,
                            "resolveJsonModule":  true
                        },
    "include":  [
                    "src"
                ]
}

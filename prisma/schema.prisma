model TheaterMember {
  id        String   @id
  name      String
  role      String
  status    String   @default("READY")
  rating    Int      @default(5)
  tags      String[]
  phone     String?
  email     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TheaterSeatReservation {
  id        String    @id
  eventId   String
  seatId    String
  status    String    @default("RESERVED")
  visitorId String?
  ticketId  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Ticket    Ticket?   @relation(fields: [ticketId], references: [id])
  Visitor   Visitor?  @relation(fields: [visitorId], references: [id])

  @@unique([eventId, seatId])
  @@index([eventId])
}

model Ticket {
  id                     String                   @id
  eventId                String
  name                   String
  description            String?
  type                   TicketType               @default(FREE)
  price                  Decimal                  @default(0.0) @db.Decimal(10, 2)
  quantity               Int
  sold                   Int                      @default(0)
  absorbFee              Boolean                  @default(false)
  minBuy                 Int                      @default(1)
  maxBuy                 Int                      @default(5)
  salesStartDate         DateTime?
  salesEndDate           DateTime?
  status                 TicketStatus             @default(ACTIVE)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  Registration           Registration[]
  TheaterSeatReservation TheaterSeatReservation[]
  Event                  Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model TicketTransfer {
  id             String    @id
  registrationId String
  fromEmail      String
  toName         String
  toEmail        String
  newCode        String    @unique
  status         String    @default("PENDING")
  transferredAt  DateTime?
  createdAt      DateTime  @default(now())

  @@index([registrationId])
}

model TimelineEvent {
  id          String   @id
  spaceId     String
  year        Int
  title       String
  description String?
  imageUrl    String?
  people      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  tenantId    String
  Space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  Tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([spaceId, year])
  @@index([tenantId])
}

model Trail {
  id                  String               @id
  title               String
  description         String?
  duration            Int?
  workIds             String[]
  imageUrl            String?
  audioUrl            String?
  videoUrl            String?
  active              Boolean              @default(true)
  categoryId          String?
  tenantId            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime
  equipamentoId       String?
  deletedAt           DateTime?
  tipoPercurso        String               @default("indoor")
  ownerId             String?
  Favorite            Favorite[]
  Category            Category?            @relation(fields: [categoryId], references: [id])
  EquipamentoCultural EquipamentoCultural? @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  Visitor             Visitor?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  Tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  VisitorVisit        VisitorVisit[]
}

model Transaction {
  id                    String            @id
  amount                Decimal           @db.Decimal(10, 2)
  status                TransactionStatus @default(PENDING)
  description           String?
  conversationId        String
  payerId               String
  payeeId               String
  paidAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime
  stripePaymentIntentId String?           @unique
  Conversation          Conversation      @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([payerId])
  @@index([status])
}

model User {
  id                    String                 @id
  email                 String                 @unique
  password              String
  name                  String
  role                  Role
  tenantId              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  active                Boolean                @default(true)
  lastLogin             DateTime?
  termsAcceptedAt       DateTime?
  termsAcceptedIp       String?
  cpf                   String?
  phone                 String?
  bio                   String?
  website               String?
  preferences           Json?
  permissions           Json?
  stripeCustomerId      String?                @unique
  stripeConnectId       String?                @unique
  AccessibilityProvider AccessibilityProvider?
  Booking               Booking[]
  CommunityPost         CommunityPost[]
  Conversation          Conversation[]
  CulturalProject       CulturalProject[]
  DeviceToken           DeviceToken[]
  Event                 Event[]
  RefreshToken          RefreshToken[]
  ServiceProvider       ServiceProvider[]
  Tenant                Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  WorkSubmission        WorkSubmission[]
}

model VestigeAlert {
  id        String    @id
  tenantId  String
  titulo    String
  mensagem  String
  tipo      String    @default("URGENTE")
  link      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Visitor {
  id                         String                       @id
  name                       String?
  email                      String?
  age                        Int?
  photoUrl                   String?
  xp                         Int                          @default(0)
  tenantId                   String
  isFake                     Boolean                      @default(false)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  isTeacher                  Boolean                      @default(false)
  BadgeRequest               BadgeRequest[]
  Certificate                Certificate[]
  CulturalPassport           CulturalPassport?
  DailyChallengeCompletion   DailyChallengeCompletion[]
  DeviceToken                DeviceToken[]
  EquipamentoCheckin         EquipamentoCheckin[]
  EventAttendance            EventAttendance[]
  Favorite                   Favorite[]
  GuestbookEntry             GuestbookEntry[]
  NotificationPreference     NotificationPreference?
  Order                      Order[]
  PassportStamp              PassportStamp[]
  ProviderReview             ProviderReview[]
  Registration               Registration[]
  Review                     Review[]
  ScavengerHuntParticipation ScavengerHuntParticipation[]
  TheaterSeatReservation     TheaterSeatReservation[]
  Trail                      Trail[]
  Tenant                     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  VisitorAchievement         VisitorAchievement[]
  VisitorAvatarCache         VisitorAvatarCache[]
  VisitorCoupon              VisitorCoupon[]
  VisitorRPG                 VisitorRPG[]
  VisitorSkin                VisitorSkin[]
  VisitorVisit               VisitorVisit[]

  @@unique([email, tenantId])
  @@index([tenantId, xp])
}

model VisitorAchievement {
  id            String      @id
  visitorId     String
  achievementId String
  unlockedAt    DateTime    @default(now())
  Achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  Visitor       Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
}

model VisitorAvatarCache {
  id        String   @id
  visitorId String
  skinId    String?
  imageUrl  String
  status    String   @default("GENERATING")
  createdAt DateTime @default(now())
  updatedAt DateTime
  Skin      Skin?    @relation(fields: [skinId], references: [id], onDelete: Cascade)
  Visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([visitorId, skinId])
}

model VisitorCard {
  id              String          @id
  cardId          String
  visitorId       String
  earnedAt        DateTime        @default(now())
  CollectibleCard CollectibleCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, visitorId])
  @@index([visitorId])
}

model VisitorCoupon {
  id         String    @id
  visitorId  String
  couponId   String
  redeemedAt DateTime  @default(now())
  usedAt     DateTime?
  Coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  Visitor    Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([visitorId, couponId])
  @@index([couponId])
  @@index([visitorId])
}

model VisitorRPG {
  id                  String         @id
  visitorId           String
  characterName       String         @default("Explorador")
  characterClass      String         @default("NOVATO")
  level               Int            @default(1)
  currentXp           Int            @default(0)
  nextLevelXp         Int            @default(100)
  totalVisits         Int            @default(0)
  totalWorks          Int            @default(0)
  totalCards          Int            @default(0)
  avatarUrl           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime
  selectedCharacterId String?
  equippedSkinId      String?
  isActive            Boolean        @default(false)
  avatarGeneratedAt   DateTime?
  avatarStatus        String         @default("NONE")
  baseAvatarUrl       String?
  selfieUrl           String?
  Skin                Skin?          @relation(fields: [equippedSkinId], references: [id])
  CharacterBase       CharacterBase? @relation(fields: [selectedCharacterId], references: [id])
  Visitor             Visitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([visitorId, selectedCharacterId])
  @@index([level])
  @@index([visitorId])
}

model VisitorSkin {
  id                 String   @id
  visitorId          String
  skinId             String
  acquiredAt         DateTime @default(now())
  generatedAvatarUrl String?
  Skin               Skin     @relation(fields: [skinId], references: [id], onDelete: Cascade)
  Visitor            Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([visitorId, skinId])
}

model VisitorVisit {
  id        String   @id
  visitorId String
  workId    String?
  trailId   String?
  eventId   String?
  source    String?
  xpGained  Int      @default(0)
  createdAt DateTime @default(now())
  tenantId  String?
  Event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Trail     Trail?   @relation(fields: [trailId], references: [id], onDelete: Cascade)
  Visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  Work      Work?    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([eventId])
  @@index([tenantId])
  @@index([trailId])
  @@index([visitorId])
  @@index([workId])
}

model Volunteer {
  id             String           @id
  name           String
  email          String
  phone          String?
  skills         String[]
  availability   String?
  status         String           @default("ACTIVE")
  totalHours     Float            @default(0)
  tenantId       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  VolunteerShift VolunteerShift[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

model VolunteerShift {
  id          String    @id
  volunteerId String
  date        DateTime
  startTime   String
  endTime     String
  hours       Float     @default(0)
  activity    String?
  confirmed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  Volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
}

model Work {
  id                   String                 @id
  title                String
  artist               String?
  year                 String?
  categoryId           String?
  room                 String?
  floor                String?
  description          String?
  imageUrl             String?
  audioUrl             String?
  librasUrl            String?
  videoUrl             String?
  latitude             Float?
  longitude            Float?
  radius               Int                    @default(5)
  published            Boolean                @default(true)
  tenantId             String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  dimensions           String?
  medium               String?
  period               String?
  technique            String?
  yearNumeric          Int?
  metadata             Json?
  deletedAt            DateTime?
  equipamentoId        String?
  sealImageUrl         String?
  captureRadiusM       Int                    @default(15)
  lat                  Float?
  lng                  Float?
  vestigeActive        Boolean                @default(false)
  vestigeExpiresAt     DateTime?
  vestigeImageUrl      String?
  vestigeTotalCapturas Int                    @default(0)
  vestigeType          String                 @default("WORK")
  AccessibilityRequest AccessibilityRequest[]
  Clue                 Clue[]
  CollectibleCard      CollectibleCard[]
  CuratorNote          CuratorNote[]
  Favorite             Favorite[]
  PassportStamp        PassportStamp[]
  Review               Review[]
  VisitorVisit         VisitorVisit[]
  Category             Category?              @relation(fields: [categoryId], references: [id])
  EquipamentoCultural  EquipamentoCultural?   @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  Tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  WorkSponsorship      WorkSponsorship[]

  @@index([tenantId, categoryId])
  @@index([tenantId, published])
  @@index([tenantId, room])
}

model WorkLoan {
  id              String    @id
  workId          String
  borrowerName    String
  borrowerContact String?
  purpose         String?
  departureDate   DateTime
  expectedReturn  DateTime?
  actualReturn    DateTime?
  status          String    @default("ACTIVE")
  conditions      String?
  insuranceInfo   String?
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@index([tenantId])
  @@index([workId])
}

model WorkSponsorship {
  id                   String            @id
  sponsorName          String
  sponsorLogo          String?
  sponsorUrl           String?
  message              String?
  active               Boolean           @default(true)
  startDate            DateTime          @default(now())
  endDate              DateTime?
  workId               String
  tenantId             String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime
  monthlyAmount        Decimal           @db.Decimal(10, 2)
  platformFeePercent   Int               @default(15)
  sponsorCNPJ          String?
  sponsorEmail         String?
  status               SponsorshipStatus @default(PENDING)
  stripeCustomerId     String?
  stripeSubscriptionId String?           @unique
  tier                 SponsorshipTier   @default(SHARED)
  Tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Work                 Work              @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workId])
}

model WorkSubmission {
  id          String    @id
  title       String
  description String?
  imageUrl    String?
  status      String    @default("PENDING")
  userId      String
  spaceId     String?
  reviewedBy  String?
  reviewedAt  DateTime?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Space       Space?    @relation(fields: [spaceId], references: [id])
  Tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id])

  @@index([tenantId, status])
}

model WorkTranslation {
  id              String   @id
  workId          String
  language        String
  title           String?
  description     String?
  audioUrl        String?
  isAutoGenerated Boolean  @default(true)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@unique([workId, language])
  @@index([tenantId])
}

model XPTransaction {
  id               String           @id
  amount           Int
  reason           String
  passportId       String
  createdAt        DateTime         @default(now())
  CulturalPassport CulturalPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
}

enum AITier {
  BASIC
  CONTINUOUS
  ADVANCED
}

enum AccessibilityServiceType {
  LIBRAS_INTERPRETATION
  AUDIO_DESCRIPTION
  CAPTIONING
  BRAILLE
  TACTILE_MODEL
  EASY_READING
  OTHER
}


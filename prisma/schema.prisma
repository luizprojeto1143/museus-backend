enum NoticeStatus {
  DRAFT
  PUBLISHED
  INSCRIPTIONS_OPEN
  INSCRIPTIONS_CLOSED
  EVALUATION
  RESULTS_PUBLISHED
  FINISHED
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_EXECUTION
  COMPLETED
  CANCELED
}

enum QRType {
  WORK

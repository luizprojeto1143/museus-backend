  VISITOR
  COLLABORATOR
}

enum SLATier {
  STANDARD
  EXTENDED
  DEDICATED
}

enum ServiceProviderType {
  TOUR_GUIDE
  RESTAURANT
  HOTEL
  TRANSPORT
  EXPERIENCE
}

enum SkinRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  EXCLUSIVE

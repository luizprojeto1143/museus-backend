  @@index([tenantId])
}

model Route {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stops RouteStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model RouteStop {
  id      String @id @default(uuid())
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order   Int
  
  // Can be a Space or a Work
  targetType String
  targetId   String
  
  latitude  Float
  longitude Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routeId, order])
}

model WorkSubmission {
  id          String  @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  status      String  @default("PENDING") // PENDING, APPROVED, REJECTED
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id])
  
  reviewedBy String?
  reviewedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

model FamilyProfile {
  id            String  @id @default(uuid())
  familyName    String
  description   String?
  coverImageUrl String?
  audioUrl      String?

  spaceId String? // Associated with a Cemetery/Space
  space   Space?  @relation(fields: [spaceId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  events FamilyEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model FamilyEvent {
  id              String @id @default(uuid())
  familyProfileId String
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  
  year        Int
  title       String
  description String?
  imageUrl    String?
  type        String @default("OTHER") // BIRTH, DEATH, MARRIAGE, ACHIEVEMENT, OTHER
  people      Json? // Array of strings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyProfileId, year])
}

// ========== SKINS & ENGAGEMENT ==========

model Skin {
  id          String   @id @default(uuid())
  tenantId    String?  // null = global skin (Master only)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String
  xpCost      Int
  rarity      SkinRarity @default(COMMON)
  characterBaseId String?
  characterBase   CharacterBase? @relation(fields: [characterBaseId], references: [id])
  
  active      Boolean  @default(true)
  eventOnly   Boolean  @default(false)
  spaceId     String?                      // Vinculada a um espaço específico
  createdAt   DateTime @default(now())
  owners      VisitorSkin[]
  equipping   VisitorRPG[]
  avatarCaches VisitorAvatarCache[]
}

model VisitorSkin {
  id          String   @id @default(uuid())
  visitorId   String
  skinId      String
  acquiredAt  DateTime @default(now())
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  skin        Skin     @relation(fields: [skinId],    references: [id], onDelete: Cascade)

  generatedAvatarUrl String?  // ← NOVO: URL do avatar gerado com esta skin

  @@unique([visitorId, skinId])
}

model BadgeRequest {
  id              String      @id @default(uuid())
  visitorId       String
  tenantId        String
  level           Int         // 1=Bronze, 2=Prata, 3=Ouro, 4=Platina
  skinImageUrl    String      // snapshot da skin no momento
  xpAtRequest     Int
  status          BadgeStatus @default(PENDING)
  addressName     String
  addressStreet   String
  addressCity     String
  addressState    String
  addressZip      String
  trackingCode    String?
  pdfUrl          String?
  requestedAt     DateTime    @default(now())
  approvedAt      DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  visitor         Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// NOVO: Cache de avatares gerados por IA por combinação visitante + skin
model VisitorAvatarCache {
  id          String    @id @default(uuid())
  visitorId   String
  skinId      String?   // null = avatar base sem skin
  imageUrl    String    // URL no R2 da imagem gerada
  status      String    @default("GENERATING") // GENERATING, READY, ERROR
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visitor     Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  skin        Skin?     @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@unique([visitorId, skinId])
}


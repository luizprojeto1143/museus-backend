  PENDING
  APPROVED
  PRINTING
  SHIPPED
  DELIVERED
  REJECTED
}

enum CategoryType {
  WORK
  TRAIL
  EVENT
  GENERAL
  SPACE
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum CertificateType {
  EVENT
  TRAIL
  VISIT
  COURSE
  CUSTOM
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum EventType {
  WORKSHOP
  EXHIBITION
  SHOW
  LECTURE
  OTHER

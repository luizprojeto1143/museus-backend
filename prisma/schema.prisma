generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AIUsage {
  id            String   @id @default(uuid())
  tenantId      String
  month         Int
  year          Int
  analysesCount Int      @default(0)
  tokensUsed    Int      @default(0)
  estimatedCost Decimal  @default(0) @db.Decimal(8, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month, year])
  @@index([tenantId])
}

model AccessibilityExecution {
  id                     String                   @id @default(uuid())
  serviceType            AccessibilityServiceType
  requestedAt            DateTime                 @default(now())
  requestedBy            String?
  requestNotes           String?
  approvedAt             DateTime?
  approvedBy             String?
  approvedBudget         Decimal?                 @db.Decimal(8, 2)
  providerId             String?
  executedAt             DateTime?
  executionNotes         String?
  deliverables           Json?
  validatedAt            DateTime?
  validatedBy            String?
  validationStatus       String?
  validationNotes        String?
  status                 String                   @default("PENDING")
  projectId              String?
  eventId                String?
  tenantId               String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  stripePaymentIntentId  String?                  @unique
  notaFiscalDate         DateTime?
  notaFiscalNumber       String?
  notaFiscalUrl          String?
  paymentReceiptUrl      String?
  // Sprint 15 — Fee snapshot
  feeConfigId            String?
  platformFeeAmountCents Int?
  culturalProject        CulturalProject?         @relation(fields: [projectId], references: [id])
  accessibilityProvider  AccessibilityProvider?   @relation(fields: [providerId], references: [id])
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialTransactionId String?
  financialTransaction   FinancialTransaction?    @relation(fields: [financialTransactionId], references: [id])

  @@index([projectId])
  @@index([providerId])
  @@index([tenantId, status])
}

model AccessibilityProvider {
  id                      String                     @id @default(uuid())
  name                    String
  document                String?
  email                   String?
  phone                   String?
  description             String?
  services                AccessibilityServiceType[]
  rating                  Float?
  completedJobs           Int                        @default(0)
  active                  Boolean                    @default(true)
  verifiedAt              DateTime?
  tenantId                String?
  userId                  String?                    @unique
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  asaasWalletId           String?
  stripeConnectId         String?                    @unique
  stripeCustomerId        String?                    @unique
  subscriptionStatus      String                     @default("INACTIVE")
  accessibilityExecutions AccessibilityExecution[]
  tenant                  Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                    User?                      @relation(fields: [userId], references: [id])
  conversations           Conversation[]
  QuoteRequest            QuoteRequest[]

  @@index([active])
  @@index([tenantId])
}

model AccessibilityRequest {
  id          String   @id @default(uuid())
  type        String
  status      String   @default("PENDING")
  notes       String?
  masterNotes String?
  workId      String
  tenantId    String
  requestedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tenantId])
}

model Achievement {
  id                  String               @id @default(uuid())
  code                String               @unique
  title               String
  description         String?
  xpReward            Int                  @default(100)
  iconUrl             String?
  condition           String?
  autoTrigger         Boolean              @default(false)
  active              Boolean              @default(true)
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorAchievements VisitorAchievement[]

  @@index([tenantId])
}

model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String?
  userId     String?
  action     AuditAction
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  tenant Tenant? @relation("TenantAuditLogs", fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model B2BBundle {
  id                String          @id @default(uuid())
  name              String
  description       String?
  totalPrice        Decimal         @db.Decimal(10, 2)
  primaryProviderId String
  tenantId          String
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  serviceProvider   ServiceProvider @relation(fields: [primaryProviderId], references: [id], onDelete: Cascade)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model BadgeRequest {
  id            String      @id @default(uuid())
  visitorId     String
  tenantId      String
  level         Int
  skinImageUrl  String
  xpAtRequest   Int
  status        BadgeStatus @default(PENDING)
  addressName   String
  addressStreet String
  addressCity   String
  addressState  String
  addressZip    String
  trackingCode  String?
  pdfUrl        String?
  requestedAt   DateTime    @default(now())
  approvedAt    DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitor       Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Booking {
  id                String           @id @default(uuid())
  userId            String
  tenantId          String
  date              DateTime
  spaceId           String?
  startTime         DateTime?
  endTime           DateTime?
  purpose           String?
  status            String           @default("CONFIRMED")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  eventId           String?
  inPersonServiceId String?
  participants      Int?
  serviceProviderId String?
  event             Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inPersonService   InPersonService? @relation(fields: [inPersonServiceId], references: [id])
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  space             Space?           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([inPersonServiceId])
  @@index([spaceId, date])
  @@index([tenantId, date])
}

model Category {
  id          String       @id @default(uuid())
  name        String
  type        CategoryType
  description String?
  active      Boolean      @default(true)
  tenantId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events      Event[]
  spaces      Space[]
  trails      Trail[]
  works       Work[]

  @@index([tenantId])
}

model Certificate {
  id                  String               @id @default(uuid())
  code                String               @unique
  visitorId           String
  tenantId            String
  type                CertificateType
  relatedId           String?
  generatedAt         DateTime             @default(now())
  status              CertificateStatus    @default(VALID)
  metadata            Json?
  templateId          String?
  certificateTemplate CertificateTemplate? @relation(fields: [templateId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitor             Visitor              @relation(fields: [visitorId], references: [id])

  @@index([tenantId])
}

model CertificateRule {
  id                  String              @id @default(uuid())
  name                String
  triggerType         TriggerType
  conditions          Json
  active              Boolean             @default(true)
  actionTemplateId    String
  tenantId            String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  certificateTemplate CertificateTemplate @relation(fields: [actionTemplateId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CertificateTemplate {
  id               String            @id @default(uuid())
  name             String
  backgroundUrl    String?
  elements         Json
  dimensions       Json?
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  certificates     Certificate[]
  certificateRules CertificateRule[]
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CharacterBase {
  id          String       @id @default(uuid())
  name        String
  description String?
  imageUrl    String
  active      Boolean      @default(true)
  tenantId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skins       Skin[]
  visitorRPGs VisitorRPG[]

  @@index([tenantId])
}

model ChatPersona {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  systemPrompt      String
  tone              String?  @default("formal-educativo")
  style             String?  @default("historico-cultural")
  historicalContext String?
  references        String[]
  temperature       Float?   @default(0.7)
  maxTokens         Int?     @default(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Clue {
  id        String   @id @default(uuid())
  riddle    String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  workId    String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  work      Work?    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CollectibleCard {
  id           String        @id @default(uuid())
  title        String
  description  String?
  imageUrl     String?
  rarity       String        @default("COMMON")
  workId       String?
  totalMinted  Int           @default(100)
  xpReward     Int           @default(10)
  tenantId     String
  createdAt    DateTime      @default(now())
  work         Work?         @relation(fields: [workId], references: [id])
  visitorCards VisitorCard[]

  @@index([rarity])
  @@index([tenantId])
}

model CommunityPost {
  id         String   @id @default(uuid())
  content    String
  mediaUrl   String?
  status     String   @default("PENDING")
  targetType String
  targetId   String
  userId     String
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([targetId])
  @@index([tenantId, status])
}

model ConservationRecord {
  id              String    @id @default(uuid())
  workId          String
  type            String
  description     String?
  responsibleName String
  condition       String?
  notes           String?
  attachments     Json?
  performedAt     DateTime  @default(now())
  nextScheduled   DateTime?
  tenantId        String
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([workId])
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("NEW")
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model ContractPlan {
  id                   String   @id @default(uuid())
  name                 String   @unique
  description          String?
  maxActiveProjects    Int      @default(10)
  maxAccessibilityReqs Int      @default(5)
  maxReportsPerMonth   Int      @default(10)
  maxAIAnalyses        Int      @default(100)
  maxWorks             Int      @default(50)
  maxEvents            Int      @default(20)
  maxChildTenants      Int      @default(0)
  maxUsers             Int      @default(5)
  aiTier               AITier   @default(BASIC)
  slaTier              SLATier  @default(STANDARD)
  supportResponseHours Int      @default(48)
  monthlyPrice         Decimal? @db.Decimal(10, 2)
  hasExecutiveReports  Boolean  @default(false)
  hasLegalCompliance   Boolean  @default(false)
  hasAPIAccess         Boolean  @default(false)
  hasWhiteLabel        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenants              Tenant[]
}

model Conversation {
  id                    String                @id @default(uuid())
  producerId            String
  providerId            String
  status                String                @default("OPEN")
  lastMessageAt         DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [producerId], references: [id], onDelete: Cascade)
  accessibilityProvider AccessibilityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  messages              Message[]
  transactions          Transaction[]

  @@unique([producerId, providerId])
  @@index([producerId])
  @@index([providerId])
}

model Coupon {
  id             String          @id @default(uuid())
  code           String          @unique
  tenantId       String
  discountType   DiscountType    @default(PERCENTAGE)
  discountValue  Decimal         @db.Decimal(10, 2)
  xpCost         Int?
  isActive       Boolean         @default(true)
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorCoupons VisitorCoupon[]

  @@index([tenantId])
}

model CulturalPassport {
  id             String          @id @default(uuid())
  culturaCoins   Int             @default(0)
  level          Int             @default(1)
  visitorId      String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  visitor        Visitor         @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  xPTransactions XPTransaction[]
}

model CulturalProject {
  id                      String                   @id @default(uuid())
  title                   String
  summary                 String?
  description             String?
  justification           String?
  culturalCategory        String?
  targetRegion            String?
  targetAudience          String?
  startDate               DateTime?
  endDate                 DateTime?
  requestedBudget         Decimal?                 @db.Decimal(10, 2)
  approvedBudget          Decimal?                 @db.Decimal(10, 2)
  expectedAudience        Int?
  actualAudience          Int?
  status                  ProjectStatus            @default(DRAFT)
  proposalUrl             String?
  attachments             Json?
  accessibilityPlan       Json?
  noticeId                String?
  proponentId             String
  eventId                 String?
  tenantId                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  aiAnalysis              Json?
  aiAnalyzedAt            DateTime?
  finalScore              Float?
  humanScore              Float?
  reviewNotes             String?
  reviewedAt              DateTime?
  reviewedBy              String?
  notaFiscalDate          DateTime?
  notaFiscalNumber        String?
  notaFiscalUrl           String?
  accessibilityExecutions AccessibilityExecution[]
  appeals                 ProjectAppeal[]
  terms                   ProjectTerm[]
  accountabilities        ProjectAccountability[]
  publicNotice            PublicNotice?            @relation(fields: [noticeId], references: [id])
  user                    User                     @relation(fields: [proponentId], references: [id])
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  QuoteRequest            QuoteRequest[]

  @@index([noticeId])
  @@index([proponentId])
  @@index([tenantId, status])
}

model ProjectAppeal {
  id                  String              @id @default(uuid())
  projectId           String
  noticeId            String?
  tenantId            String
  proponentId         String
  type                ProjectAppealType   @default(APPEAL)
  status              ProjectAppealStatus @default(SUBMITTED)
  reason              String
  requestedAdjustment String?
  response            String?
  counterResponse     String?
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  project             CulturalProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proponent           User                @relation(fields: [proponentId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([noticeId])
  @@index([tenantId, status])
  @@index([proponentId])
}

model ProjectTerm {
  id                String            @id @default(uuid())
  projectId         String
  tenantId          String
  proponentId       String
  status            ProjectTermStatus @default(PENDING_SIGNATURE)
  title             String
  termsText         String
  documentUrl       String?
  signedDocumentUrl String?
  signedAt          DateTime?
  signedByIp        String?
  createdBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  project           CulturalProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proponent         User              @relation(fields: [proponentId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tenantId, status])
  @@index([proponentId])
}

model ProjectAccountability {
  id               String                      @id @default(uuid())
  projectId        String
  tenantId         String
  proponentId      String
  status           ProjectAccountabilityStatus @default(DRAFT)
  periodStart      DateTime?
  periodEnd        DateTime?
  executionSummary String?
  audienceReached  Int?
  amountSpent      Decimal?                    @db.Decimal(12, 2)
  documents        Json?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  reviewNotes      String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  project          CulturalProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proponent        User                        @relation(fields: [proponentId], references: [id])
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tenantId, status])
  @@index([proponentId])
}

model CuratorNote {
  id        String   @id @default(uuid())
  content   String
  author    String?
  pinned    Boolean  @default(false)
  workId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workId])
}

model DailyChallenge {
  id                        String                     @id @default(uuid())
  title                     String
  description               String
  xpReward                  Int                        @default(50)
  type                      String
  target                    Int                        @default(1)
  conditions                Json?
  activeDate                DateTime
  tenantId                  String
  createdAt                 DateTime                   @default(now())
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyChallengeCompletions DailyChallengeCompletion[]

  @@index([tenantId])
}

model DailyChallengeCompletion {
  id             String         @id @default(uuid())
  visitorId      String
  challengeId    String
  progress       Int            @default(0)
  completed      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  dailyChallenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  visitor        Visitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([visitorId, challengeId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  token     String   @unique
  platform  String   @default("web")
  userAgent String?
  userId    String?
  visitorId String?
  tenantId  String?
  active    Boolean  @default(true)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([userId])
  @@index([visitorId])
  @@index([tenantId])
}

model Donation {
  id                      String                @id @default(uuid())
  amount                  Decimal               @db.Decimal(10, 2)
  currency                String                @default("BRL")
  donorName               String?
  donorEmail              String?
  message                 String?
  anonymous               Boolean               @default(false)
  status                  String                @default("PENDING")
  paymentId               String?
  tenantId                String
  createdAt               DateTime              @default(now())
  platformFee             Decimal?              @db.Decimal(10, 2)
  stripePaymentIntentId   String?               @unique
  stripeCheckoutSessionId String?               @unique
  // Sprint 15 — Fee snapshot
  feeConfigId             String?
  platformFeePercent      Decimal?              @db.Decimal(5, 2)
  platformFeeAmountCents  Int?
  feePaidBy               FeePaidBy?
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialTransactionId  String?
  financialTransaction    FinancialTransaction? @relation(fields: [financialTransactionId], references: [id])

  @@index([tenantId])
}

model EquipamentoCheckin {
  id                  String              @id @default(uuid())
  equipamentoId       String
  visitorId           String
  method              String
  lat                 Float?
  lng                 Float?
  xpGanho             Int                 @default(20)
  createdAt           DateTime            @default(now())
  equipamentoCultural EquipamentoCultural @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  visitor             Visitor             @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([equipamentoId, visitorId, createdAt])
}

model EquipamentoCultural {
  id                  String               @id @default(uuid())
  tenantId            String
  nome                String
  slug                String               @unique
  tipo                String
  descricao           String?
  missao              String?
  endereco            String
  cidade              String
  estado              String               @default("MG")
  lat                 Float?
  lng                 Float?
  raioCheckinMetros   Int                  @default(50)
  fotoCapaUrl         String?
  fotoGaleriaUrls     String[]
  corPrimaria         String?
  logoUrl             String?
  qrCodeEntrada       String               @unique
  qrCodeUrl           String?
  urlPublica          String?
  horarios            Json?
  telefone            String?
  email               String?
  site                String?
  acessivelCadeira    Boolean              @default(false)
  acessivelLibras     Boolean              @default(false)
  acessivelAudio      Boolean              @default(false)
  ativo               Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  maxEvents           Int                  @default(20)
  maxTrails           Int                  @default(10)
  maxWorks            Int                  @default(50)
  planId              String?
  plantaUrl           String?
  equipamentoCheckins EquipamentoCheckin[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events              Event[]
  spaces              Space[]
  trails              Trail[]
  works               Work[]

  @@index([tenantId])
}

model Event {
  id                           String                        @id @default(uuid())
  title                        String
  description                  String?
  type                         EventType                     @default(OTHER)
  instructor                   String?
  materials                    String?
  format                       String                        @default("PRESENTIAL")
  visibility                   String                        @default("PUBLIC")
  isOnline                     Boolean                       @default(false)
  startDate                    DateTime
  endDate                      DateTime?
  eventId                      String?                       @unique
  location                     String?
  zipCode                      String?
  address                      String?
  number                       String?
  complement                   String?
  neighborhood                 String?
  city                         String?
  state                        String?
  meetingLink                  String?
  platform                     String?
  producerName                 String?
  producerDescription          String?
  producerLogoUrl              String?
  coverImageUrl                String?
  coverUrl                     String?
  certificateBackgroundUrl     String?
  certificateText              String?
  minMinutesForCertificate     Int?
  audioUrl                     String?
  videoUrl                     String?
  views                        Int                           @default(0)
  status                       String                        @default("DRAFT")
  customFormSchema             Json?
  galleryUrls                  String?
  categoryId                   String?
  spaceId                      String?
  tenantId                     String
  certificateRequiresSurvey    Boolean                       @default(false)

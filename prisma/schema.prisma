enum PlatformFeeSource {
  TICKET
  THEATER
  SHOP
  DONATION
  MEMBERSHIP
  SPONSORSHIP_SHARED
  SPONSORSHIP_EXCLUSIVE
  SERVICE
  ACCESSIBILITY
  MARKETPLACE
  GUIDE
  PROVIDER_SUBSCRIPTION
  SKIN_PREMIUM
  AVATAR_AI
  BADGE_PRINTING
  BADGE_REISSUE
  BADGE_SHIPPING
  SKIN_EVENT_EXCLUSIVE
}

enum FeePaidBy {
  BUYER
  SELLER
}

model PlatformFeeConfig {
  id String @id @default(cuid())

  // null = regra global (vale para todos os tenants sem config especifica)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  sourceType PlatformFeeSource

  name     String? // Ex: "Taxa padrao bilheteria", "Betim piloto"
  priority Int     @default(0) // Maior priority vence em empates

  percentage Decimal  @db.Decimal(5, 2)
  fixedFee   Decimal? @db.Decimal(10, 2)

  feePaidBy FeePaidBy @default(SELLER)

  isActive Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  notes String?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([sourceType])
  @@index([isActive])
  @@index([tenantId, sourceType, isActive])
  @@index([startsAt])
  @@index([endsAt])
}

enum SkinAssetType {
  IMAGE_2D
  ANIMATED_2D
  MODEL_3D
  EFFECT
  FRAME
  ACCESSORY
}

enum SkinAcquisitionMode {
  FREE
  XP_ONLY
  MONEY_ONLY
  XP_OR_MONEY
  XP_PLUS_MONEY
  UNLOCK_ONLY
}

enum SkinRigType {
  NONE
  HUMANOID
  VRM
  CUSTOM
}

enum SkinPurchaseType {
  FREE
  XP
  MONEY
  UNLOCK
}

enum SkinPurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum XpTransactionType {
  EARN
  SPEND
  REFUND
  ADMIN_GRANT
  ADMIN_DEBIT
}

model SkinPurchase {
  id                      String             @id @default(uuid())
  tenantId                String?
  visitorId               String
  skinId                  String
  purchaseType            SkinPurchaseType
  status                  SkinPurchaseStatus
  xpAmount                Int?
  moneyAmountCents        Int?
  currency                String?            @default("BRL")
  platformRevenueCents    Int?
  gatewayFeeCents         Int?
  netPlatformRevenueCents Int?
  financialTransactionId  String?
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?
  stripeChargeId          String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  paidAt                  DateTime?
  refundedAt              DateTime?
  visitor                 Visitor            @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  skin                    Skin               @relation(fields: [skinId], references: [id], onDelete: Cascade)
  tenant                  Tenant?            @relation(fields: [tenantId], references: [id])

  @@index([visitorId])
  @@index([skinId])
  @@index([tenantId])
  @@index([status])
}

model XpTransaction {
  id           String            @id @default(uuid())
  visitorId    String
  type         XpTransactionType
  amount       Int
  balanceAfter Int
  reason       String
  sourceType   String?
  sourceId     String?
  createdById  String?
  createdAt    DateTime          @default(now())
  visitor      Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
}

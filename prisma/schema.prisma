  EXPIRED
}

enum TicketType {
  FREE
  PAID
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  RELEASED
}

enum TriggerType {
  TRAIL_COMPLETED
  EVENT_ATTENDED
  XP_THRESHOLD
  MANUAL
}


model TokenBlacklist {
  id String @id @default(uuid())
  token String @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StripeWebhookEvent {
  id String @id
  type String
  processedAt DateTime @default(now())
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MASTER
  ADMIN
  PRODUCER
  VISITOR
}

enum QRType {
  WORK
  TRAIL
  EVENT
  SPACE
  TENANT // QR Code para um Museu ou Ponto Histórico
  EQUIPAMENTO // NOVO: QR Code de entrada do equipamento cultural
  CUSTOM
}

enum CategoryType {
  WORK
  TRAIL
  EVENT
  GENERAL
}

enum CertificateType {
  EVENT
  TRAIL
  VISIT
  COURSE
  CUSTOM
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum TriggerType {
  TRAIL_COMPLETED
  EVENT_ATTENDED
  XP_THRESHOLD
  MANUAL
}

enum TenantType {
  MUSEUM
  PRODUCER
  SECRETARIA // Secretaria de Cultura Municipal
  CULTURAL_SPACE // Centro Cultural, Biblioteca, Arquivo, etc.
  CITY // Cidade/Prefeitura (tenant pai)
  ARCHITECTURAL_LANDMARK // Ponto de interesse arquitetônico/histórico
}

enum SkinRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  EXCLUSIVE
}

enum BadgeStatus {
  PENDING
  APPROVED
  PRINTING
  SHIPPED
  DELIVERED
  REJECTED
}

// ========== GOVERNANCE / CONTRACT PLANS ==========

enum AITier {
  BASIC // Sem IA ou IA limitada
  CONTINUOUS // IA com cotas mensais
  ADVANCED // IA ilimitada
}

enum SLATier {
  STANDARD // 48h resposta
  EXTENDED // 24h resposta
  DEDICATED // 4h resposta + suporte dedicado
}

model ContractPlan {
  id          String  @id @default(uuid())
  name        String  @unique // "Start", "Pro", "Enterprise"
  description String?

  // Limites de Uso
  maxActiveProjects    Int @default(10)
  maxAccessibilityReqs Int @default(5) // por mês
  maxReportsPerMonth   Int @default(10)
  maxAIAnalyses        Int @default(100) // por mês
  maxWorks             Int @default(50)
  maxEvents            Int @default(20)
  maxChildTenants      Int @default(0) // equipamentos filhos
  maxUsers             Int @default(5)

  // Tiers
  aiTier               AITier  @default(BASIC)
  slaTier              SLATier @default(STANDARD)
  supportResponseHours Int     @default(48)

  // Preço (referência interna)
  monthlyPrice Decimal? @db.Decimal(10, 2)

  // Features extras
  hasExecutiveReports Boolean @default(false)
  hasLegalCompliance  Boolean @default(false)
  hasAPIAccess        Boolean @default(false)
  hasWhiteLabel       Boolean @default(false)

  tenants Tenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIUsage {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  month Int // 1-12
  year  Int

  analysesCount Int     @default(0)
  tokensUsed    Int     @default(0)
  estimatedCost Decimal @default(0) @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, month, year])
  @@index([tenantId])
}

model Tenant {
  id   String     @id @default(uuid())
  type TenantType @default(MUSEUM)
  name String
  slug String     @unique

  deletedAt DateTime?

  // Hierarchy - Permite Cidade ter Museus/Espaços filhos
  parentId String? // ID do tenant pai (ex: Secretaria -> Museus)
  parent   Tenant?  @relation("TenantHierarchy", fields: [parentId], references: [id])
  children Tenant[] @relation("TenantHierarchy")

  // Plan & Limits (Governance)
  planId       String?
  contractPlan ContractPlan? @relation(fields: [planId], references: [id])
  aiUsage      AIUsage[]

  // Legacy fields (for backward compatibility)
  plan            String @default("START") // "START", "PRO", "ENTERPRISE"
  maxWorks        Int    @default(50) // Limite de obras cadastradas
  capacityPerHour Int    @default(50) // Capacidade máxima de visitantes por hora

  // Settings
  mission                  String?
  address                  String?
  openingHours             String?
  whatsapp                 String?
  email                    String?
  website                  String?
  logoUrl                  String?
  coverImageUrl            String?
  appIconUrl               String?
  bannerUrl                String?
  signatureUrl             String? // Assinatura do responsável para certificados
  certificateBackgroundUrl String? // Imagem de fundo personalizada para certificados (A4 Paisagem)
  frameUrl                 String? // Moldura personalizada para as telas do tenant

  mapImageUrl String?
  latitude    Float?
  longitude   Float?

  // Welcome Audio/Video (Boas-vindas)
  welcomeAudioUrl String? // Áudio de boas-vindas ao museu
  welcomeVideoUrl String? // Vídeo institucional de boas-vindas

  // Theme
  primaryColor   String  @default("#d4af37")
  secondaryColor String  @default("#cd7f32")
  theme          String  @default("dark") // "light" | "dark"
  historicalFont Boolean @default(true)

  // Feature Flags - Módulos habilitados por tenant
  featureWorks         Boolean @default(true) // Catálogo de obras/artefatos
  featureTrails        Boolean @default(true) // Trilhas e roteiros
  featureEvents        Boolean @default(true) // Eventos e check-in
  featureGamification  Boolean @default(true) // XP, conquistas, ranking, passaporte
  featureQRCodes       Boolean @default(true) // QR codes e scanner
  featureChatAI        Boolean @default(false) // Chat IA (premium)
  featureShop          Boolean @default(false) // Loja virtual (premium)
  featureDonations     Boolean @default(false) // Doações e mural de doadores (premium)
  featureCertificates  Boolean @default(true) // Certificados de participação
  featureReviews       Boolean @default(true) // Favoritos e avaliações
  featureGuestbook     Boolean @default(true) // Livro de visitas
  featureAccessibility Boolean @default(true) // Libras e acessibilidade
  featureMinigames     Boolean @default(false) // Minigame (Art Run)
  featureServices      Boolean @default(false) // Produtor: oferece serviços
  featureTickets       Boolean @default(false) // Venda de ingressos

  // Municipal Features - Gestão Pública
  featureEditais              Boolean @default(false) // Editais públicos
  featureProjects             Boolean @default(false) // Projetos culturais
  featureAccessibilityMgmt    Boolean @default(false) // Gestão de acessibilidade pública
  featureProviders            Boolean @default(false) // Cadastro de prestadores
  featureInstitutionalReports Boolean @default(false) // Relatórios institucionais
  featureEditaisSubmission    Boolean @default(false) // Produtores podem submeter a editais

  // Phase 1 Features
  featureCuratorNotes Boolean @default(false) // Notas de curador nas obras
  featureNPS          Boolean @default(false) // Net Promoter Score
  featureSponsorship  Boolean @default(false) // Patrocínio de obras

  // Terms & Privacy (LGPD)
  termsOfUse    String? // Texto dos termos de uso (Markdown/HTML)
  privacyPolicy String? // Política de privacidade

  // Institutional Data (Cultura Viva Reports)
  cnpj                String?
  legalNature         String? // "Publico Municipal", "Privado com fins lucrativos", etc.
  foundationYear      Int?
  typology            String? // "Museu", "Centro Cultural", "Arquivo", etc.
  legalRepresentative String?

  // Accessibility Data (LBI Compliance)
  accessibilityResources Json? // { physical: [], sensory: [], content: [] }

  // Financial Settings
  asaasWalletId String? // ID da Carteira Asaas para recebimento (Split)

  // Mode: Museum or City
  isCityMode Boolean @default(false) // false = Museu, true = Cidade/Roteiro Turístico

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  works                 Work[]
  trails                Trail[]
  events                Event[]
  visitors              Visitor[]
  achievements          Achievement[]
  qrcodes               QRCode[]
  categories            Category[]
  chatPersona           ChatPersona?
  bookings              Booking[]
  spaces                Space[]
  timelineEvents        TimelineEvent[]
  workSubmissions       WorkSubmission[]
  familyProfiles        FamilyProfile[]
  guestbookEntries      GuestbookEntry[]
  clues                 Clue[]
  certificates          Certificate[]
  certificateTemplates  CertificateTemplate[]
  certificateRules      CertificateRule[]
  auditLogs             AuditLog[]
  newsletters           NewsletterSubscription[]
  donations             Donation[]
  products              Product[]
  orders                Order[]
  dailyChallenges       DailyChallenge[]
  scavengerHunts        ScavengerHunt[]
  files                 File[]
  floorPlans            FloorPlan[]
  accessibilityRequests AccessibilityRequest[]
  coupons               Coupon[]
  curatorNotes          CuratorNote[]
  npsResponses          NPSResponse[]
  sponsorships          WorkSponsorship[]
  sentimentAnalyses     SentimentAnalysis[]
  inPersonServices      InPersonService[]      // Serviços criados por este tenant (Master)
  enabledServices       TenantInPersonService[] // Serviços que este tenant ativou (Qualquer museu)
  
  // roadmap 2026
  communityPosts  CommunityPost[]
  quizzes         Quiz[]
  routes          Route[]

  // Municipal Features Relations
  publicNotices           PublicNotice[]
  culturalProjects        CulturalProject[]
  accessibilityExecutions AccessibilityExecution[]
  accessibilityProviders  AccessibilityProvider[]
  skins                  Skin[]
  badgeRequests          BadgeRequest[]
  characterBases         CharacterBase[]
  equipamentos           EquipamentoCultural[]
  vestigeAlerts          VestigeAlert[]

  @@index([parentId])
}

model EquipamentoCultural {
  id               String    @id @default(cuid())
  tenantId         String
 
  // Identidade
  nome             String
  slug             String    @unique  // ex: 'casa-da-cultura-betim'
  tipo             String    // museu|teatro|biblioteca|centro_cultural|galeria|arquivo|outdoor
  descricao        String?   @db.Text
  missao           String?   @db.Text  // 'Sobre este espaco'
 
  // Localizacao fisica
  endereco         String
  cidade           String
  estado           String    @default("MG")
  lat              Float?    // coordenadas GPS
  lng              Float?
  raioCheckinMetros Int      @default(50)  // raio valido para check-in GPS
 
  // Identidade visual
  fotoCapaUrl      String?
  fotoGaleriaUrls  String[]  // ate 8 fotos do espaco
  corPrimaria      String?   // hex — white label por espaco
  logoUrl          String?
 
  // Acesso fisico e digital
  qrCodeEntrada    String    @unique @default(cuid())
  qrCodeUrl        String?   // URL da imagem do QR para impressao
  urlPublica       String?   // ex: culturaviva.betim.mg.gov.br/casa-da-cultura
 
  // Funcionamento
  horarios         Json?     // { seg:'9-17', ter:'9-17', sab:'9-13', dom:null }
  telefone         String?
  email            String?
  site             String?
 
  // Acessibilidade
  acessivelCadeira Boolean  @default(false)
  acessivelLibras  Boolean  @default(false)
  acessivelAudio   Boolean  @default(false)
 
  // Plano e limites (por equipamento)
  planId           String?
  maxWorks         Int       @default(50)
  maxTrails        Int       @default(10)
  maxEvents        Int       @default(20)
  ativo            Boolean   @default(true)
 
  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
 
  // Relacoes
  tenant           Tenant    @relation(fields:[tenantId], references:[id])
  spaces           Space[]
  works            Work[]
  trails           Trail[]
  events           Event[]
  checkins         EquipamentoCheckin[]
  plantaUrl        String?   // imagem da planta baixa

  @@index([tenantId])
}

model EquipamentoCheckin {
  id               String    @id @default(cuid())
  equipamentoId    String
  visitorId        String
  method           String    // 'qr_entrada' | 'gps' | 'manual'
  lat              Float?
  lng              Float?
  xpGanho          Int       @default(20)
  createdAt        DateTime  @default(now())
 
  equipamento      EquipamentoCultural @relation(fields: [equipamentoId], references: [id])
  visitor          Visitor             @relation(fields: [visitorId], references: [id])
 
  @@unique([equipamentoId, visitorId, createdAt])  // permite revisitas
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  role     Role
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  active    Boolean   @default(true)
  lastLogin DateTime?

  termsAcceptedAt DateTime? // Data de aceite dos termos
  termsAcceptedIp String? // IP do aceite

  bookings     Booking[]
  deviceTokens DeviceToken[]

  // Producer Data
  cpf           String?
  phone         String?
  bio           String?
  website       String?
  preferences   Json? // { emailNotifications: boolean, publicProfile: boolean, twoFactor: boolean, language: string }
  refreshTokens RefreshToken[]

  // Enterprise Features
  producerConversations Conversation[]         @relation("ProducerConversations")
  providerProfile       AccessibilityProvider?
  culturalProjects      CulturalProject[]
  communityPosts        CommunityPost[]
  workSubmissions       WorkSubmission[]
}

model RefreshToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Audit
  ipAddress String?
  userAgent String?

  @@index([userId])
}

// File - Gerencia uploads no sistema
model File {
  id           String @id @default(uuid())
  filename     String
  originalName String
  url          String
  type         String // image, audio, video, document
  mimeType     String
  size         Int // bytes

  // Onde o arquivo é usado
  usedIn   String? // work, trail, event, tenant, etc
  usedInId String? // ID do registro onde é usado

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  uploadedBy String? // userId

  useInAi Boolean @default(false) // Arquivo deve ser usado como contexto na IA?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([usedIn, usedInId])
}

model Category {
  id          String       @id @default(uuid())
  name        String
  type        CategoryType
  description String?
  active      Boolean      @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  works  Work[]
  trails Trail[]
  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id     String  @id @default(uuid())
  title  String
  artist String?
  year   String?

  deletedAt DateTime?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  room        String?
  floor       String?
  description String?
  imageUrl    String?
  audioUrl    String?
  librasUrl   String?
  videoUrl    String?

  // Art metadata (Phase 1 — Timeline & Comparator)
  technique   String? // Ex: "Óleo sobre tela", "Escultura em bronze"
  period      String? // Ex: "Barroco", "Modernismo", "Contemporâneo"
  medium      String? // Ex: "Pintura", "Escultura", "Gravura"
  dimensions  String? // Ex: "120x80cm"
  yearNumeric Int? // Ano numérico para ordenação na timeline

  // Geo-fencing
  latitude  Float?
  longitude Float?
  radius    Int     @default(5) // metros
  published Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  equipamentoId String?
  equipamento   EquipamentoCultural? @relation(fields: [equipamentoId], references: [id])
  sealImageUrl  String? // Imagem do carimbo/selo para o passaporte (legado)

  // === NOVO: Sistema de Vestígios ===
  lat              Float?     // coordenada GPS da obra
  lng              Float?     // coordenada GPS da obra
  captureRadiusM   Int        @default(15)  // raio de captura em metros
  vestigeActive    Boolean    @default(true) // false = Relíquia (não capturável)
  vestigeType      String     @default("WORK") // WORK | STREET_ART | INSTALLATION
  vestigeExpiresAt DateTime?  // data de encerramento da exposição
  vestigeTotalCapturas Int    @default(0)   // contador global de capturas
  vestigeImageUrl  String?    // imagem do carimbo (diferente da imageUrl da obra)

  metadata Json? // Usado para traduções e outros metadados flexíveis

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Notificações e Push
  visits                VisitorVisit[]
  stamps                PassportStamp[]
  clues                 Clue[]
  favorites             Favorite[]
  reviews               Review[]
  accessibilityRequests AccessibilityRequest[]
  curatorNotes          CuratorNote[]
  sponsorships          WorkSponsorship[]

  @@index([tenantId, categoryId])
  @@index([tenantId, room])
  @@index([tenantId, published])
}

model Trail {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    Int? // minutos
  workIds     String[] // lista de IDs de obras na ordem

  deletedAt DateTime?

  // Media
  imageUrl String?
  audioUrl String? // Áudio-guia de introdução da trilha
  videoUrl String? // Vídeo de apresentação da trilha

  active Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  equipamentoId String?
  equipamento   EquipamentoCultural? @relation(fields: [equipamentoId], references: [id])
  tipoPercurso  String              @default("indoor") // indoor | outdoor | hibrido

  visits    VisitorVisit[]
  favorites Favorite[]
  
  ownerId   String?
  owner     Visitor? @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Clue {
  id     String  @id @default(uuid())
  riddle String // Charada
  answer String // Resposta esperada
  order  Int     @default(0)
  active Boolean @default(true)

  workId String?
  work   Work?   @relation(fields: [workId], references: [id]) // Pista pode levar a uma obra

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventAttendance {
  id          String   @id @default(uuid())
  eventId     String
  visitorId   String
  checkInTime DateTime @default(now())
  status      String   @default("PRESENT") // PRESENT, REGISTERED

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitor Visitor @relation(fields: [visitorId], references: [id])

  createdAt DateTime @default(now())

  @@unique([eventId, visitorId])
}

// Update Event model to support Online Events
enum EventType {
  WORKSHOP
  EXHIBITION
  SHOW
  LECTURE
  OTHER
}

model Event {
  id          String  @id @default(uuid())
  title       String
  description String?

  deletedAt DateTime?

  // Type & Workshop Logic
  type       EventType @default(OTHER)
  instructor String? // Name of the instructor/facilitator
  materials  String? // List of materials needed/provided

  // Format & Visibility
  format     String  @default("PRESENTIAL") // PRESENTIAL, ONLINE, HYBRID
  visibility String  @default("PUBLIC") // PUBLIC, PRIVATE
  isOnline   Boolean @default(false) // Keep for backward compatibility or computed

  // Date & Time
  startDate    DateTime
  endDate      DateTime?
  // Link to generated event
  eventId      String?   @unique
  originEvent  Event?    @relation("EventDerivation", fields: [eventId], references: [id])
  derivedEvent Event?    @relation("EventDerivation")

  // Location (Presential)
  location     String? // Name of the place e.g. "Sítio Terra Prometida"
  zipCode      String?
  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Online
  meetingLink String? // Zoom, Meet, etc.
  platform    String? // ZOOM, YOUTUBE, MEET, OTHER

  // Producer Info
  producerName        String?
  producerDescription String?
  producerLogoUrl     String?
  coverImageUrl       String?
  coverUrl            String? // Alias for cover image (used in projects-\u003eevents)

  // Certificate Settings
  certificateBackgroundUrl String?
  certificateText          String?
  minMinutesForCertificate Int?

  // Media
  audioUrl String? // Áudio-guia de introdução do evento
  videoUrl String? // Vídeo promocional do evento

  views  Int    @default(0)
  status String @default("DRAFT") // DRAFT, PUBLISHED, CANCELED, FINISHED

  // Sympla Killer Features 🚀
  customFormSchema Json? // Array of { id, label, type, required, options }
  galleryUrls      String? // JSON array of strings (store as string for SQLite compat or Json if Postgres supports)
  // Note: Using Json type is better if DB supports it. Prisma supports Json for SQLite.

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  equipamentoId String?
  equipamento   EquipamentoCultural? @relation(fields: [equipamentoId], references: [id])

  visits                    VisitorVisit[]
  attendances               EventAttendance[]
  tickets                   Ticket[]
  bookings                  Booking[]
  registrations             Registration[]
  reviews                   Review[]
  favorites                 Favorite[]
  surveyQuestions           SurveyQuestion[]
  certificateRequiresSurvey Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startDate])
}

// ========== SURVEY / SATISFACTION POLL ==========

enum SurveyQuestionType {
  STARS // 1-5 stars rating
  TEXT // Free text answer
  CHOICE // Multiple choice (radio)
  NPS // Net Promoter Score (0-10)
}

model SurveyQuestion {
  id       String             @id @default(uuid())
  eventId  String
  question String
  type     SurveyQuestionType @default(STARS)
  options  Json? // Array of strings for CHOICE type
  required Boolean            @default(true)
  order    Int                @default(0)

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  createdAt DateTime @default(now())

  @@index([eventId])
}

model SurveyResponse {
  id         String  @id @default(uuid())
  questionId String
  visitorId  String?
  guestEmail String?
  answer     String // Text, number (1-5 or 0-10), or selected option

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([questionId, visitorId])
  @@unique([questionId, guestEmail])
  @@index([questionId])
}

enum TicketType {
  FREE
  PAID
}

enum TicketStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  EXPIRED
}

model Ticket {
  id             String       @id @default(uuid())
  eventId        String
  name           String
  description    String?
  type           TicketType   @default(FREE)
  price          Decimal      @default(0.0) // 10.00
  quantity       Int // Total available
  sold           Int          @default(0) // Track sold count
  absorbFee      Boolean      @default(false)
  minBuy         Int          @default(1)
  maxBuy         Int          @default(5)
  salesStartDate DateTime?
  salesEndDate   DateTime?
  status         TicketStatus @default(ACTIVE)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELED
  CHECKED_IN
}

model Registration {
  id        String  @id @default(uuid())
  code      String  @unique // Unique booking code e.g. "ABC-123"
  eventId   String
  ticketId  String
  visitorId String? // If linked to a known visitor

  // Guest Data (if not a registered visitor yet)
  guestName  String
  guestEmail String

  status             RegistrationStatus @default(PENDING)
  checkInDate        DateTime?
  pricePaid          Decimal            @default(0.0)
  platformFee        Decimal?           @db.Decimal(10, 2)
  asaasPaymentId     String?
  asaasPaymentStatus String?

  // Sympla Killer Features 🚀
  customFormData Json? // { questionId: answer }

  // Relations
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket  Ticket   @relation(fields: [ticketId], references: [id])
  visitor Visitor? @relation(fields: [visitorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id       String  @id @default(uuid())
  name     String?
  email    String?
  age      Int?
  photoUrl String?
  xp       Int     @default(0)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isFake    Boolean @default(false)
  isTeacher Boolean @default(false)

  visits                 VisitorVisit[]
  achievements           VisitorAchievement[]
  stamps                 PassportStamp[]
  attendances            EventAttendance[]
  guestbookEntries       GuestbookEntry[]
  certificates           Certificate[]
  registrations          Registration[]
  favorites              Favorite[]
  reviews                Review[]
  notificationPreference NotificationPreference?
  orders                 Order[]
  challengeCompletions   DailyChallengeCompletion[]
  huntParticipations     ScavengerHuntParticipation[]
  deviceTokens           DeviceToken[]
  coupons                VisitorCoupon[]
  vRPGs                  VisitorRPG[]
  vSkins                 VisitorSkin[]
  badgeRequests          BadgeRequest[]
  equipamentoCheckins    EquipamentoCheckin[]
  trails                 Trail[]
  avatarCaches           VisitorAvatarCache[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, tenantId])
  @@index([tenantId, xp])
}

model VisitorVisit {
  id        String  @id @default(uuid())
  visitorId String
  workId    String?
  trailId   String?
  eventId   String?
  source    String? // "QR" | "APP"
  xpGained  Int     @default(0)

  visitor Visitor @relation(fields: [visitorId], references: [id])
  work    Work?   @relation(fields: [workId], references: [id])
  trail   Trail?  @relation(fields: [trailId], references: [id])
  event   Event?  @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([workId])
  @@index([eventId])
  @@index([trailId])
  @@index([createdAt]) // For date range queries
}

model Achievement {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String?
  xpReward    Int     @default(100)
  iconUrl     String?
  condition   String?
  autoTrigger Boolean @default(false)
  active      Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  visitors VisitorAchievement[]
}

model VisitorAchievement {
  id            String   @id @default(uuid())
  visitorId     String
  achievementId String
  unlockedAt    DateTime @default(now())

  visitor     Visitor     @relation(fields: [visitorId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])
}

model PassportStamp {
  id               String    @id @default(uuid())
  visitorId        String
  workId           String
  
  // Metadados da Conquista
  raridade         String    // PIONEER | RARE | EPIC | LEGENDARY | RELIC
  numeroCaptura    Int       // qual o numero desta captura global (ex: 42 de 500)
  xpGanho          Int       @default(50)
  
  // Localizacao da Captura (para prova de presenca)
  latCaptura       Float?
  lngCaptura       Float?
  accuracyMetros   Float?
  
  // Status de Reliquia
  isRelic          Boolean   @default(false)
  convertidoEm     DateTime? // data que virou reliquia (exposicao acabou)
  
  stampedAt        DateTime  @default(now())

  visitor          Visitor   @relation(fields: [visitorId], references: [id])
  work             Work      @relation(fields: [workId], references: [id])

  @@unique([visitorId, workId]) // um vestigio por obra por visitante
}

// Alertas urgentes ou novidades globais da cidade/museu
model VestigeAlert {
  id               String    @id @default(uuid())
  tenantId         String
  titulo           String
  mensagem         String
  tipo             String    @default("URGENTE") // URGENTE | NOVIDADE | EXPIRANDO
  link             String?   // rota interna do pwa (ex: /vestiges/42)
  expiresAt        DateTime?
  
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
}

model QRCode {
  id          String  @id @default(uuid())
  code        String  @unique
  type        QRType
  referenceId String?
  title       String
  xpReward    Int     @default(5)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ChatPersona {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  systemPrompt      String
  tone              String?  @default("formal-educativo")
  style             String?  @default("historico-cultural")
  historicalContext String?
  references        String[]
  temperature       Float?   @default(0.7)
  maxTokens         Int?     @default(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Booking {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date     DateTime

  // Space Management
  spaceId   String?
  space     Space?    @relation(fields: [spaceId], references: [id])
  startTime DateTime?
  endTime   DateTime?
  purpose   String?

  status    String   @default("CONFIRMED") // CONFIRMED, CANCELLED, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Novas adições para Serviços Presenciais e Agendamentos
  inPersonServiceId String?
  inPersonService   InPersonService? @relation(fields: [inPersonServiceId], references: [id])
  participants      Int?
  eventId           String?
  event             Event?           @relation(fields: [eventId], references: [id])

  @@index([tenantId, date])
  @@index([spaceId, date])
  @@index([inPersonServiceId])
  @@index([eventId])
}

model Space {
  id          String  @id @default(uuid())
  name        String
  description String?
  capacity    Int     @default(10)
  type        String  @default("ROOM") // ROOM, AUDITORIUM, LAB, STUDIO
  resources   Json? // Array of strings e.g. ["Projector", "WiFi", "AC"]
  isBookable  Boolean @default(true)
  imageUrl    String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  equipamentoId String?
  equipamento   EquipamentoCultural? @relation(fields: [equipamentoId], references: [id])

  bookings Booking[]
  events   Event[]
  
  timelineEvents  TimelineEvent[]
  workSubmissions WorkSubmission[]
  familyProfiles  FamilyProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model InPersonService {
  id          String   @id @default(uuid())
  name        String
  description String?
  active      Boolean  @default(true)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bookings    Booking[]
  enabledBy   TenantInPersonService[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model TenantInPersonService {
  id                String   @id @default(uuid())
  active            Boolean  @default(true)

  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  inPersonServiceId String
  inPersonService   InPersonService  @relation(fields: [inPersonServiceId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, inPersonServiceId])
  @@index([tenantId])
  @@index([inPersonServiceId])
}

model GuestbookEntry {
  id        String  @id @default(uuid())
  message   String
  isVisible Boolean @default(true)

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Certificate {
  id          String            @id @default(uuid())
  code        String            @unique
  visitorId   String
  tenantId    String
  type        CertificateType
  relatedId   String?
  generatedAt DateTime          @default(now())
  status      CertificateStatus @default(VALID)
  metadata    Json?

  visitor Visitor @relation(fields: [visitorId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  templateId String?
  template   CertificateTemplate? @relation(fields: [templateId], references: [id])
}

model CertificateTemplate {
  id            String  @id @default(uuid())
  name          String
  backgroundUrl String?
  elements      Json // Array of { field, x, y, style }
  dimensions    Json? // { width, height }

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  certificates Certificate[]
  rules        CertificateRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CertificateRule {
  id          String      @id @default(uuid())
  name        String
  triggerType TriggerType
  conditions  Json // Logic for trigger
  active      Boolean     @default(true)

  actionTemplateId String
  actionTemplate   CertificateTemplate @relation(fields: [actionTemplateId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== NEW MODELS FOR WORLD-CLASS FEATURES ==========

// Favorites - Save works to personal collection
model Favorite {
  id String @id @default(uuid())

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  workId String?
  work   Work?   @relation(fields: [workId], references: [id], onDelete: Cascade)

  trailId String?
  trail   Trail?  @relation(fields: [trailId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([visitorId, workId])
  @@unique([visitorId, trailId])
  @@unique([visitorId, eventId])
  @@index([workId]) // D-001 Reverse lookup
}

// Reviews - Star ratings and comments
model Review {
  id String @id @default(uuid())

  rating  Int // 1-5 stars
  comment String?

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  workId String?
  work   Work?   @relation(fields: [workId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  approved Boolean @default(false) // Moderation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([visitorId, workId])
  @@unique([visitorId, eventId])
  @@index([workId]) // D-002 Sorting reviews by work
  @@index([eventId])
}

// Audit Log - Track admin actions
model AuditLog {
  id String @id @default(uuid())

  action   String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity   String // Work, Event, Visitor, etc.
  entityId String?

  userId    String?
  userEmail String?

  oldData Json?
  newData Json?

  ipAddress String?
  userAgent String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Newsletter Subscription
model NewsletterSubscription {
  id     String  @id @default(uuid())
  email  String
  name   String?
  active Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([email, tenantId])
}

// Donation
model Donation {
  id String @id @default(uuid())

  amount      Decimal  @db.Decimal(10, 2)
  platformFee Decimal? @db.Decimal(10, 2)
  currency    String   @default("BRL")

  donorName  String?
  donorEmail String?
  message    String?
  anonymous  Boolean @default(false)

  status    String  @default("PENDING") // PENDING, COMPLETED, FAILED
  paymentId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Notification Preferences
model NotificationPreference {
  id String @id @default(uuid())

  visitorId String  @unique
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  emailEvents       Boolean @default(true)
  emailNewsletter   Boolean @default(true)
  pushNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== E-COMMERCE MODULE ==========

// Product - Museum shop items
model Product {
  id String @id @default(uuid())

  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  sku         String?
  imageUrl    String?
  stock       Int     @default(0)
  active      Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, tenantId])
}

// Contact Requests (Landing Page)
model ContactRequest {
  id      String  @id @default(uuid())
  name    String
  email   String
  subject String?
  message String
  status  String  @default("NEW") // NEW, READ, ARCHIVED, REPLIED

  tenantId String? // Optional, if related to a specific tenant/project

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Order - Shop purchases
model Order {
  id String @id @default(uuid())

  status      String   @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED, CANCELLED
  total       Decimal  @db.Decimal(10, 2)
  platformFee Decimal? @db.Decimal(10, 2)

  // Customer info
  customerName  String
  customerEmail String
  customerPhone String?

  // Shipping
  shippingAddress String?
  shippingMethod  String?
  shippingCost    Decimal? @db.Decimal(10, 2)

  // Payment
  paymentMethod String?
  paymentId     String?
  invoiceUrl    String?
  bankSlipUrl   String?
  pixQrCode     String? // Base64 image
  pixPayload    String? // Copy and paste code

  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([visitorId])
  @@index([status])
}

model OrderItem {
  id String @id @default(uuid())

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ========== ADVANCED GAMIFICATION ==========

// Daily Challenge
model DailyChallenge {
  id String @id @default(uuid())

  title       String
  description String
  xpReward    Int    @default(50)

  type       String // VISIT_WORK, ANSWER_QUIZ, SHARE_SOCIAL, etc.
  target     Int    @default(1) // How many times to complete
  conditions Json? // Additional conditions

  activeDate DateTime // The day this challenge is active

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  completions DailyChallengeCompletion[]

  createdAt DateTime @default(now())
}

model DailyChallengeCompletion {
  id String @id @default(uuid())

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  progress  Int     @default(0)
  completed Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([visitorId, challengeId])
}

// Scavenger Hunt - Treasure hunt game
model ScavengerHunt {
  id String @id @default(uuid())

  title       String
  description String?

  xpReward    Int     @default(200)
  badgeReward String? // Achievement code to unlock

  active   Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  steps        ScavengerHuntStep[]
  participants ScavengerHuntParticipation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScavengerHuntStep {
  id String @id @default(uuid())

  order  Int
  clue   String // Hint to find the next step
  answer String // Expected QR code or answer

  huntId String
  hunt   ScavengerHunt @relation(fields: [huntId], references: [id], onDelete: Cascade)

  workId String? // Optional: step is at this work
}

model ScavengerHuntParticipation {
  id String @id @default(uuid())

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  huntId String
  hunt   ScavengerHunt @relation(fields: [huntId], references: [id], onDelete: Cascade)

  currentStep Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([visitorId, huntId])
}

// ========== FLOOR PLANS (MULTI-FLOOR MAPS) ==========

model FloorPlan {
  id       String @id @default(uuid())
  name     String // "Térreo", "1º Andar", etc
  floor    Int    @default(0) // 0 = térreo, 1, 2, etc
  imageUrl String
  order    Int    @default(0) // Ordem de exibição no seletor

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, order])
}

// ========== SERVICES REQUESTS ==========

model AccessibilityRequest {
  id String @id @default(uuid())

  type   String // "LIBRAS", "AUDIO_DESC", "BOTH"
  status String @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED

  notes       String? // Admin notes
  masterNotes String? // Master response/notes

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requestedBy String? // User ID or Name/Email

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

// Push Notification Device Tokens
model DeviceToken {
  id        String  @id @default(uuid())
  token     String  @unique // FCM token
  platform  String  @default("web") // web, android, ios
  userAgent String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  tenantId String?

  active   Boolean  @default(true)
  lastUsed DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([visitorId])
  @@index([active])
}

// ========== GESTÃO PÚBLICA CULTURAL ==========

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_EXECUTION
  COMPLETED
  CANCELED
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  INSCRIPTIONS_OPEN
  INSCRIPTIONS_CLOSED
  EVALUATION
  RESULTS_PUBLISHED
  FINISHED
}

enum AccessibilityServiceType {
  LIBRAS_INTERPRETATION
  AUDIO_DESCRIPTION
  CAPTIONING
  BRAILLE
  TACTILE_MODEL
  EASY_READING
}

// Edital Público
model PublicNotice {
  id           String  @id @default(uuid())
  title        String
  description  String?
  objectives   String?
  requirements String?

  // Datas
  publishDate      DateTime?
  inscriptionStart DateTime
  inscriptionEnd   DateTime
  evaluationEnd    DateTime?
  resultsDate      DateTime?
  executionEnd     DateTime?

  // Valores
  totalBudget   Decimal? @db.Decimal(12, 2)
  maxPerProject Decimal? @db.Decimal(10, 2)
  minPerProject Decimal? @db.Decimal(10, 2)

  // Categorização
  culturalCategories String[]
  targetRegions      String[]

  status      NoticeStatus @default(DRAFT)
  documentUrl String?
  attachments Json?

  requiresAccessibilityPlan Boolean @default(true)
  showScoresInResults       Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  projects CulturalProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([inscriptionEnd])
}

// Projeto Cultural
model CulturalProject {
  id            String  @id @default(uuid())
  title         String
  summary       String?
  description   String?
  justification String?

  // Categorização
  culturalCategory String?
  targetRegion     String?
  targetAudience   String?

  // Cronograma
  startDate DateTime?
  endDate   DateTime?

  // Financeiro
  requestedBudget Decimal? @db.Decimal(10, 2)
  approvedBudget  Decimal? @db.Decimal(10, 2)

  // Metas
  expectedAudience Int?
  actualAudience   Int?

  status ProjectStatus @default(DRAFT)

  // Documentos
  proposalUrl String?
  attachments Json?

  // Plano de Acessibilidade
  accessibilityPlan Json?

  // Análise IA
  aiAnalysis   Json?
  aiAnalyzedAt DateTime?

  // Avaliação (Secretaria/Admin)
  reviewNotes String?
  reviewedBy  String?
  reviewedAt  DateTime?
  humanScore  Float?
  finalScore  Float?

  // Vínculos
  noticeId String?
  notice   PublicNotice? @relation(fields: [noticeId], references: [id])

  proponentId String
  proponent   User   @relation(fields: [proponentId], references: [id])

  // Evento gerado a partir deste projeto (quando publicado na Agenda)
  eventId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accessibilityExecutions AccessibilityExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([noticeId])
  @@index([proponentId])
}

// Execução de Acessibilidade
model AccessibilityExecution {
  id String @id @default(uuid())

  serviceType AccessibilityServiceType

  // Solicitação
  requestedAt  DateTime @default(now())
  requestedBy  String?
  requestNotes String?

  // Aprovação
  approvedAt     DateTime?
  approvedBy     String?
  approvedBudget Decimal?  @db.Decimal(8, 2)

  // Execução
  providerId String?
  provider   AccessibilityProvider? @relation(fields: [providerId], references: [id])

  executedAt     DateTime?
  executionNotes String?
  deliverables   Json?

  // Validação
  validatedAt      DateTime?
  validatedBy      String?
  validationStatus String?
  validationNotes  String?

  status String @default("PENDING")

  // Vínculos
  projectId String?
  project   CulturalProject? @relation(fields: [projectId], references: [id])

  eventId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([projectId])
  @@index([providerId])
}

// Prestador de Acessibilidade
model AccessibilityProvider {
  id String @id @default(uuid())

  name        String
  document    String?
  email       String?
  phone       String?
  description String?

  services AccessibilityServiceType[]

  rating        Float?
  completedJobs Int       @default(0)
  active        Boolean   @default(true)
  verifiedAt    DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  executions    AccessibilityExecution[]
  conversations Conversation[]

  // Link to Platform User (Login)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Financial Data (for Splits)
  asaasWalletId String? // ID da Carteira Asaas do Prestador

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([tenantId])
}

// ========== INBOX & NEGOTIATION SYSTEM ==========

model Conversation {
  id String @id @default(uuid())

  producerId String
  producer   User   @relation("ProducerConversations", fields: [producerId], references: [id], onDelete: Cascade)

  providerId String
  provider   AccessibilityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  status String @default("OPEN") // OPEN, CLOSED, ARCHIVED

  lastMessageAt DateTime @default(now())

  messages     Message[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([producerId, providerId])
  @@index([producerId])
  @@index([providerId])
}

enum MessageType {
  TEXT
  PROPOSAL
  PAYMENT_REQUEST
  SYSTEM_ALERT
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId   String // User ID (could be Producer or Provider's User)
  senderType String // "PRODUCER" or "PROVIDER" or "SYSTEM"

  content     String
  type        MessageType @default(TEXT)
  attachments Json? // Array of file URLs

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

// ========== ASAAS PAYMENT SYSTEM ==========

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  RELEASED // Funds released to provider
}

model Transaction {
  id String @id @default(uuid())

  amount      Decimal           @db.Decimal(10, 2)
  status      TransactionStatus @default(PENDING)
  description String?

  // Relations
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  payerId String // User (Producer)
  payeeId String // Provider ID

  // Asaas Data
  asaasId         String? @unique // External Transaction ID
  paymentMethod   String? // PIX, CREDIT_CARD, BOLETO
  asaasInvoiceUrl String?
  pixQrCode       String? // Base64
  pixCopyPaste    String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([payerId])
  @@index([status])
}

// ========== GAMIFIED REWARDS (CROSS-SELLING) ==========

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id       String @id @default(uuid())
  code     String @unique
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(10, 2) // Ex: 10 para 10%, ou 15.00 para R$ 15,00

  xpCost   Int? // Custo em XP para o visitante comprar esse cupom (se nulo, cupom normal)
  isActive Boolean @default(true)

  description String?

  visitorCoupons VisitorCoupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model VisitorCoupon {
  id        String  @id @default(uuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  redeemedAt DateTime  @default(now()) // Quando usou XP para adquirir (ou quando ganhou)
  usedAt     DateTime? // Quando de fato aplicou numa compra na Loja

  @@unique([visitorId, couponId])
  @@index([visitorId])
  @@index([couponId])
}

// ========== PHASE 1 — ANALYTICS & UX ==========

// Curator Notes — Admin publishes contextual notes on works
model CuratorNote {
  id String @id @default(uuid())

  content String // Texto da nota do curador
  author  String? // Nome do curador
  pinned  Boolean @default(false)

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workId])
  @@index([tenantId])
}

// NPS — Net Promoter Score responses
model NPSResponse {
  id String @id @default(uuid())

  score   Int // 0-10
  comment String?

  visitorId String?
  email     String? // For anonymous NPS

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// Sentiment Analysis — AI-generated insights from reviews
model SentimentAnalysis {
  id String @id @default(uuid())

  sentiment  String // POSITIVE, NEGATIVE, NEUTRAL
  confidence Float // 0.0 - 1.0
  keywords   String[] // Ex: ["iluminação", "audiodescrição", "limpeza"]
  summary    String? // AI-generated summary

  reviewCount Int     @default(0)
  period      String? // Ex: "2026-03", "2026-Q1"

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  generatedAt DateTime @default(now())

  @@index([tenantId])
}

// Work Sponsorship — Companies/people sponsor a work
model WorkSponsorship {
  id String @id @default(uuid())

  sponsorName String
  sponsorLogo String?
  sponsorUrl  String?
  message     String?

  amount    Decimal?  @db.Decimal(10, 2)
  active    Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workId])
  @@index([tenantId])
}

// ========== PHASE 2 — EDUCATION & GROUPS ==========

model TeacherProfile {
  id String @id @default(uuid())

  name    String
  email   String
  phone   String?
  school  String // Nome da escola
  city    String?
  subject String? // Disciplina principal

  tenantId String

  schoolVisits SchoolVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, tenantId])
  @@index([tenantId])
}

model SchoolVisit {
  id String @id @default(uuid())

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolName   String
  grade        String? // "6º ano", "Ensino Médio", etc
  studentCount Int     @default(0)
  ageGroup     String? // "6-8", "9-12", "13-17", "18+"

  visitDate       DateTime
  selectedWorkIds String[] // IDs das obras selecionadas pelo professor


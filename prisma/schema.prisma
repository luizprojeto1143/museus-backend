datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MASTER
  ADMIN
  PRODUCER
  VISITOR
}

enum QRType {
  WORK
  TRAIL
  EVENT
  SPACE
  CUSTOM
}

enum CategoryType {
  WORK
  TRAIL
  EVENT
  GENERAL
}

enum CertificateType {
  EVENT
  TRAIL
  VISIT
  COURSE
  CUSTOM
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum TriggerType {
  TRAIL_COMPLETED
  EVENT_ATTENDED
  XP_THRESHOLD
  MANUAL
}

enum TenantType {
  MUSEUM
  PRODUCER
  SECRETARIA      // Secretaria de Cultura Municipal
  CULTURAL_SPACE  // Centro Cultural, Biblioteca, Arquivo, etc.
  CITY            // Cidade/Prefeitura (tenant pai)
}

// ========== GOVERNANCE / CONTRACT PLANS ==========

enum AITier {
  BASIC       // Sem IA ou IA limitada
  CONTINUOUS  // IA com cotas mensais
  ADVANCED    // IA ilimitada
}

enum SLATier {
  STANDARD    // 48h resposta
  EXTENDED    // 24h resposta
  DEDICATED   // 4h resposta + suporte dedicado
}

model ContractPlan {
  id                    String   @id @default(uuid())
  name                  String   @unique // "Start", "Pro", "Enterprise"
  description           String?
  
  // Limites de Uso
  maxActiveProjects     Int      @default(10)
  maxAccessibilityReqs  Int      @default(5)     // por mês
  maxReportsPerMonth    Int      @default(10)
  maxAIAnalyses         Int      @default(100)   // por mês
  maxWorks              Int      @default(50)
  maxEvents             Int      @default(20)
  maxChildTenants       Int      @default(0)     // equipamentos filhos
  maxUsers              Int      @default(5)
  
  // Tiers
  aiTier                AITier   @default(BASIC)
  slaTier               SLATier  @default(STANDARD)
  supportResponseHours  Int      @default(48)
  
  // Preço (referência interna)
  monthlyPrice          Decimal? @db.Decimal(10, 2)
  
  // Features extras
  hasExecutiveReports   Boolean  @default(false)
  hasLegalCompliance    Boolean  @default(false)
  hasAPIAccess          Boolean  @default(false)
  hasWhiteLabel         Boolean  @default(false)
  
  tenants               Tenant[]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AIUsage {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  month           Int      // 1-12
  year            Int
  
  analysesCount   Int      @default(0)
  tokensUsed      Int      @default(0)
  estimatedCost   Decimal  @default(0) @db.Decimal(8, 2)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([tenantId, month, year])
  @@index([tenantId])
}

model Tenant {
  id        String     @id @default(uuid())
  type      TenantType @default(MUSEUM)
  name      String
  slug      String     @unique
  
  // Hierarchy - Permite Cidade ter Museus/Espaços filhos
  parentId      String?  // ID do tenant pai (ex: Secretaria -> Museus)
  parent        Tenant?  @relation("TenantHierarchy", fields: [parentId], references: [id])
  children      Tenant[] @relation("TenantHierarchy")
  
  // Plan & Limits (Governance)
  planId        String?
  contractPlan  ContractPlan? @relation(fields: [planId], references: [id])
  aiUsage       AIUsage[]
  
  // Legacy fields (for backward compatibility)
  plan          String   @default("START")  // "START", "PRO", "ENTERPRISE"
  maxWorks      Int      @default(50)        // Limite de obras cadastradas

  // Settings
  mission       String?
  address       String?
  openingHours  String?
  whatsapp      String?
  email         String?
  website       String?
  logoUrl       String?
  coverImageUrl String?
  appIconUrl    String?
  bannerUrl     String?
  signatureUrl  String? // Assinatura do responsável para certificados
  certificateBackgroundUrl String? // Imagem de fundo personalizada para certificados (A4 Paisagem)
  
  // Map Settings
  mapImageUrl   String?
  latitude      Float?
  longitude     Float?
  
  // Welcome Audio/Video (Boas-vindas)
  welcomeAudioUrl String? // Áudio de boas-vindas ao museu
  welcomeVideoUrl String? // Vídeo institucional de boas-vindas
  
  // Theme
  primaryColor   String   @default("#d4af37")
  secondaryColor String   @default("#cd7f32")
  theme          String   @default("dark") // "light" | "dark"
  historicalFont Boolean  @default(true)

  // Feature Flags - Módulos habilitados por tenant
  featureWorks        Boolean @default(true)   // Catálogo de obras/artefatos
  featureTrails       Boolean @default(true)   // Trilhas e roteiros
  featureEvents       Boolean @default(true)   // Eventos e check-in
  featureGamification Boolean @default(true)   // XP, conquistas, ranking, passaporte
  featureQRCodes      Boolean @default(true)   // QR codes e scanner
  featureChatAI       Boolean @default(false)  // Chat IA (premium)
  featureShop         Boolean @default(false)  // Loja virtual (premium)
  featureDonations    Boolean @default(false)  // Doações e mural de doadores (premium)
  featureCertificates Boolean @default(true)   // Certificados de participação
  featureReviews      Boolean @default(true)   // Favoritos e avaliações
  featureGuestbook    Boolean @default(true)   // Livro de visitas
  featureAccessibility Boolean @default(true)  // Libras e acessibilidade
  featureMinigames     Boolean @default(false)  // Minigame (Art Run)
  featureServices      Boolean @default(false)  // Produtor: oferece serviços
  featureTickets       Boolean @default(false)  // Venda de ingressos
  
  // Municipal Features - Gestão Pública
  featureEditais           Boolean @default(false)  // Editais públicos
  featureProjects          Boolean @default(false)  // Projetos culturais
  featureAccessibilityMgmt Boolean @default(false)  // Gestão de acessibilidade pública
  featureProviders         Boolean @default(false)  // Cadastro de prestadores
  featureInstitutionalReports Boolean @default(false) // Relatórios institucionais
  featureEditaisSubmission    Boolean @default(false) // Produtores podem submeter a editais
  
  // Terms & Privacy (LGPD)
  termsOfUse    String?  // Texto dos termos de uso (Markdown/HTML)
  privacyPolicy String?  // Política de privacidade

  // Institutional Data (Cultura Viva Reports)
  cnpj                String?
  legalNature         String? // "Publico Municipal", "Privado com fins lucrativos", etc.
  foundationYear      Int?
  typology            String? // "Museu", "Centro Cultural", "Arquivo", etc.
  legalRepresentative String?
  
  // Accessibility Data (LBI Compliance)
  accessibilityResources Json? // { physical: [], sensory: [], content: [] }

  // Mode: Museum or City
  isCityMode Boolean @default(false) // false = Museu, true = Cidade/Roteiro Turístico

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  works      Work[]
  trails     Trail[]
  events     Event[]
  visitors   Visitor[]
  achievements Achievement[]
  qrcodes    QRCode[]
  categories Category[]
  chatPersona ChatPersona?
  bookings    Booking[]
  guestbookEntries GuestbookEntry[]
  clues       Clue[]
  certificates Certificate[]
  certificateTemplates CertificateTemplate[]
  certificateRules     CertificateRule[]
  auditLogs    AuditLog[]
  newsletters  NewsletterSubscription[]
  donations    Donation[]
  products     Product[]
  orders       Order[]
  dailyChallenges DailyChallenge[]
  scavengerHunts  ScavengerHunt[]
  files           File[]
  floorPlans      FloorPlan[]
  accessibilityRequests AccessibilityRequest[]
  
  // Municipal Features Relations
  publicNotices            PublicNotice[]
  culturalProjects         CulturalProject[]
  accessibilityExecutions  AccessibilityExecution[]
  accessibilityProviders   AccessibilityProvider[]
  
  @@index([parentId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  active    Boolean  @default(true)
  lastLogin DateTime?
  
  
  termsAcceptedAt DateTime? // Data de aceite dos termos
  termsAcceptedIp String?   // IP do aceite

  bookings  Booking[]
  deviceTokens DeviceToken[]
  
  // Producer Data
  cpf       String?
  phone     String?
  bio       String?
  website   String?
  preferences Json?   // { emailNotifications: boolean, publicProfile: boolean, twoFactor: boolean, language: string }
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  // Audit
  ipAddress String?
  userAgent String?
  
  @@index([userId])
}

// File - Gerencia uploads no sistema
model File {
  id          String   @id @default(uuid())
  filename    String
  originalName String
  url         String
  type        String   // image, audio, video, document
  mimeType    String
  size        Int      // bytes
  
  // Onde o arquivo é usado
  usedIn      String?  // work, trail, event, tenant, etc
  usedInId    String?  // ID do registro onde é usado
  
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  uploadedBy  String?  // userId
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([usedIn, usedInId])
}

model Category {
  id          String       @id @default(uuid())
  name        String
  type        CategoryType
  description String?
  active      Boolean      @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  works  Work[]
  trails Trail[]
  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id          String   @id @default(uuid())
  title       String
  artist      String?
  year        String?
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  room        String?
  floor       String?
  description String?
  imageUrl    String?
  audioUrl    String?
  librasUrl   String?
  videoUrl    String?
  
  // Geo-fencing
  latitude    Float?
  longitude   Float?
  radius      Int      @default(5) // metros
  published   Boolean  @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits   VisitorVisit[]
  stamps   PassportStamp[]
  clues    Clue[]
  favorites Favorite[]
  reviews  Review[]
  accessibilityRequests AccessibilityRequest[]

  @@index([tenantId, categoryId])
  @@index([tenantId, room])
  @@index([tenantId, published])
}

model Trail {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    Int?     // minutos
  workIds     String[] // lista de IDs de obras na ordem
  
  // Media
  imageUrl    String?
  audioUrl    String?  // Áudio-guia de introdução da trilha
  videoUrl    String?  // Vídeo de apresentação da trilha
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  visits VisitorVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Clue {
  id        String   @id @default(uuid())
  riddle    String // Charada
  answer    String // Resposta esperada
  order     Int      @default(0)
  active    Boolean  @default(true)
  
  workId    String?
  work      Work?    @relation(fields: [workId], references: [id]) // Pista pode levar a uma obra

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventAttendance {
  id          String   @id @default(uuid())
  eventId     String
  visitorId   String
  checkInTime DateTime @default(now())
  status      String   @default("PRESENT") // PRESENT, REGISTERED

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitor     Visitor  @relation(fields: [visitorId], references: [id])

  createdAt DateTime @default(now())
  
  @@unique([eventId, visitorId])
}

// Update Event model to support Online Events
model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  
  // Format & Visibility
  format      String   @default("PRESENTIAL") // PRESENTIAL, ONLINE, HYBRID
  visibility  String   @default("PUBLIC")     // PUBLIC, PRIVATE
  isOnline    Boolean  @default(false)        // Keep for backward compatibility or computed
  
  // Date & Time
  startDate   DateTime
  endDate     DateTime?
  // Link to generated event
  eventId     String?   @unique
  originEvent Event?    @relation("EventDerivation", fields: [eventId], references: [id])
  derivedEvent Event?   @relation("EventDerivation")

  
  // Location (Presential)
  location    String?  // Name of the place e.g. "Sítio Terra Prometida"
  zipCode     String?
  address     String?
  number      String?
  complement  String?
  neighborhood String?
  city        String?
  state       String?
  
  // Online
  meetingLink String?   // Zoom, Meet, etc.
  platform    String?   // ZOOM, YOUTUBE, MEET, OTHER
  
  // Producer Info
  producerName        String?
  producerDescription String?
  producerLogoUrl     String?
  coverImageUrl       String?
  coverUrl            String?  // Alias for cover image (used in projects-\u003eevents)
  
  // Certificate Settings
  certificateBackgroundUrl String?
  certificateText String?
  minMinutesForCertificate Int?
  
  // Media
  audioUrl    String?  // Áudio-guia de introdução do evento
  videoUrl    String?  // Vídeo promocional do evento

  views       Int      @default(0)
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, CANCELED, FINISHED

  // Sympla Killer Features 🚀
  customFormSchema Json?   // Array of { id, label, type, required, options }
  galleryUrls      String? // JSON array of strings (store as string for SQLite compat or Json if Postgres supports)
  // Note: Using Json type is better if DB supports it. Prisma supports Json for SQLite.
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  visits      VisitorVisit[]
  attendances EventAttendance[]
  tickets     Ticket[]
  registrations Registration[]
  reviews     Review[]
  surveyQuestions SurveyQuestion[]
  certificateRequiresSurvey Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startDate])
}

// ========== SURVEY / SATISFACTION POLL ==========

enum SurveyQuestionType {
  STARS     // 1-5 stars rating
  TEXT      // Free text answer
  CHOICE    // Multiple choice (radio)
  NPS       // Net Promoter Score (0-10)
}

model SurveyQuestion {
  id        String   @id @default(uuid())
  eventId   String
  question  String
  type      SurveyQuestionType @default(STARS)
  options   Json?    // Array of strings for CHOICE type
  required  Boolean  @default(true)
  order     Int      @default(0)
  
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]
  
  createdAt DateTime @default(now())
  
  @@index([eventId])
}

model SurveyResponse {
  id         String   @id @default(uuid())
  questionId String
  visitorId  String?
  guestEmail String?
  answer     String   // Text, number (1-5 or 0-10), or selected option
  
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  
  @@unique([questionId, visitorId])
  @@unique([questionId, guestEmail])
  @@index([questionId])
}

enum TicketType {
  FREE
  PAID
}

enum TicketStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  EXPIRED
}

model Ticket {
  id            String      @id @default(uuid())
  eventId       String
  name          String
  description   String?
  type          TicketType  @default(FREE)
  price         Decimal     @default(0.0) // 10.00
  quantity      Int         // Total available
  sold          Int         @default(0)   // Track sold count
  absorbFee     Boolean     @default(false)
  minBuy        Int         @default(1)
  maxBuy        Int         @default(5)
  salesStartDate DateTime?
  salesEndDate  DateTime?
  status        TicketStatus @default(ACTIVE)

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELED
  CHECKED_IN
}

model Registration {
  id            String             @id @default(uuid())
  code          String             @unique // Unique booking code e.g. "ABC-123"
  eventId       String
  ticketId      String
  visitorId     String?            // If linked to a known visitor
  
  // Guest Data (if not a registered visitor yet)
  guestName     String
  guestEmail    String
  
  status        RegistrationStatus @default(PENDING)
  checkInDate   DateTime?
  pricePaid     Decimal            @default(0.0)
  
  // Sympla Killer Features 🚀
  customFormData Json?             // { questionId: answer }
  
  // Relations
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket        Ticket    @relation(fields: [ticketId], references: [id])
  visitor       Visitor?  @relation(fields: [visitorId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Visitor {
  id        String   @id @default(uuid())
  name      String?
  email     String?
  age       Int?
  photoUrl  String?
  xp        Int      @default(0)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isFake   Boolean @default(false)

  visits       VisitorVisit[]
  achievements VisitorAchievement[]
  stamps       PassportStamp[]
  attendances  EventAttendance[]
  guestbookEntries GuestbookEntry[]
  certificates Certificate[]
  registrations Registration[]
  favorites    Favorite[]
  reviews      Review[]
  notificationPreference NotificationPreference?
  orders       Order[]
  challengeCompletions DailyChallengeCompletion[]
  huntParticipations   ScavengerHuntParticipation[]
  deviceTokens         DeviceToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, tenantId])
  @@index([tenantId, xp])
}

model VisitorVisit {
  id        String   @id @default(uuid())
  visitorId String
  workId    String?
  trailId   String?
  eventId   String?
  source    String? // "QR" | "APP"
  xpGained  Int      @default(0)

  visitor   Visitor @relation(fields: [visitorId], references: [id])
  work      Work?   @relation(fields: [workId], references: [id])
  trail     Trail?  @relation(fields: [trailId], references: [id])
  event     Event?  @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
  
  @@index([visitorId])
  @@index([workId])
  @@index([eventId])
  @@index([trailId])
  @@index([createdAt]) // For date range queries
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  xpReward    Int      @default(100)
  iconUrl     String?
  condition   String?
  autoTrigger Boolean  @default(false)
  active      Boolean  @default(true)
  
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  visitors VisitorAchievement[]
}

model VisitorAchievement {
  id           String   @id @default(uuid())
  visitorId    String
  achievementId String
  unlockedAt   DateTime @default(now())

  visitor     Visitor     @relation(fields: [visitorId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])
}

model PassportStamp {
  id        String   @id @default(uuid())
  visitorId String
  workId    String
  stampedAt DateTime @default(now())

  visitor Visitor @relation(fields: [visitorId], references: [id])
  work    Work    @relation(fields: [workId], references: [id])
}

model QRCode {
  id          String   @id @default(uuid())
  code        String   @unique
  type        QRType
  referenceId String?
  title       String
  xpReward    Int      @default(5)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}


model ChatPersona {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  systemPrompt String
  tone      String?  @default("formal-educativo")
  style     String?  @default("historico-cultural")
  historicalContext String?
  references String[]
  temperature Float? @default(0.7)
  maxTokens Int?     @default(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuestbookEntry {
  id        String   @id @default(uuid())
  message   String
  isVisible Boolean  @default(true)
  
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Certificate {
  id          String   @id @default(uuid())
  code        String   @unique
  visitorId   String
  tenantId    String
  type        CertificateType
  relatedId   String?
  generatedAt DateTime @default(now())
  status      CertificateStatus @default(VALID)
  metadata    Json?


  visitor     Visitor @relation(fields: [visitorId], references: [id])
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  templateId  String?
  template    CertificateTemplate? @relation(fields: [templateId], references: [id])
}

model CertificateTemplate {
  id            String   @id @default(uuid())
  name          String
  backgroundUrl String?
  elements      Json     // Array of { field, x, y, style }
  dimensions    Json?    // { width, height }
  
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  certificates  Certificate[]
  rules         CertificateRule[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CertificateRule {
  id               String      @id @default(uuid())
  name             String
  triggerType      TriggerType
  conditions       Json        // Logic for trigger
  active           Boolean     @default(true)
  
  actionTemplateId String
  actionTemplate   CertificateTemplate @relation(fields: [actionTemplateId], references: [id])
  
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ========== NEW MODELS FOR WORLD-CLASS FEATURES ==========

// Favorites - Save works to personal collection
model Favorite {
  id        String   @id @default(uuid())
  
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  

  
  @@unique([visitorId, workId])
  @@index([workId]) // D-001 Reverse lookup
}

// Reviews - Star ratings and comments
model Review {
  id        String   @id @default(uuid())
  
  rating    Int      // 1-5 stars
  comment   String?
  
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  
  workId    String?
  work      Work?    @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  approved  Boolean  @default(false) // Moderation
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([visitorId, workId])
  @@unique([visitorId, eventId])
  @@index([workId]) // D-002 Sorting reviews by work
  @@index([eventId])
}

// Audit Log - Track admin actions
model AuditLog {
  id        String   @id @default(uuid())
  
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String   // Work, Event, Visitor, etc.
  entityId  String?
  
  userId    String?
  userEmail String?
  
  oldData   Json?
  newData   Json?
  
  ipAddress String?
  userAgent String?
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

// Newsletter Subscription
model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String
  name      String?
  active    Boolean  @default(true)
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([email, tenantId])
}

// Donation
model Donation {
  id          String   @id @default(uuid())
  
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("BRL")
  
  donorName   String?
  donorEmail  String?
  message     String?
  anonymous   Boolean  @default(false)
  
  status      String   @default("PENDING") // PENDING, COMPLETED, FAILED
  paymentId   String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

// Notification Preferences
model NotificationPreference {
  id              String   @id @default(uuid())
  
  visitorId       String   @unique
  visitor         Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  
  emailEvents     Boolean  @default(true)
  emailNewsletter Boolean  @default(true)
  pushNotifications Boolean @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ========== E-COMMERCE MODULE ==========

// Product - Museum shop items
model Product {
  id          String   @id @default(uuid())
  
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  sku         String?
  imageUrl    String?
  stock       Int      @default(0)
  active      Boolean  @default(true)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  orderItems  OrderItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([sku, tenantId])
}

// Contact Requests (Landing Page)
model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("NEW") // NEW, READ, ARCHIVED, REPLIED
  
  tenantId  String?  // Optional, if related to a specific tenant/project
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// Order - Shop purchases
model Order {
  id          String   @id @default(uuid())
  
  status      String   @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED, CANCELLED
  total       Decimal  @db.Decimal(10, 2)
  
  // Customer info
  customerName  String
  customerEmail String
  customerPhone String?
  
  // Shipping
  shippingAddress String?
  shippingMethod  String?
  shippingCost    Decimal? @db.Decimal(10, 2)
  
  // Payment
  paymentMethod String?
  paymentId     String?
  
  visitorId   String?
  visitor     Visitor? @relation(fields: [visitorId], references: [id])
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  items       OrderItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([visitorId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
  
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ========== ADVANCED GAMIFICATION ==========

// Daily Challenge
model DailyChallenge {
  id          String   @id @default(uuid())
  
  title       String
  description String
  xpReward    Int      @default(50)
  
  type        String   // VISIT_WORK, ANSWER_QUIZ, SHARE_SOCIAL, etc.
  target      Int      @default(1) // How many times to complete
  conditions  Json?    // Additional conditions
  
  activeDate  DateTime // The day this challenge is active
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  completions DailyChallengeCompletion[]
  
  createdAt   DateTime @default(now())
}

model DailyChallengeCompletion {
  id          String   @id @default(uuid())
  
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  
  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@unique([visitorId, challengeId])
}

// Scavenger Hunt - Treasure hunt game
model ScavengerHunt {
  id          String   @id @default(uuid())
  
  title       String
  description String?
  
  xpReward    Int      @default(200)
  badgeReward String?  // Achievement code to unlock
  
  active      Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  steps       ScavengerHuntStep[]
  participants ScavengerHuntParticipation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScavengerHuntStep {
  id          String   @id @default(uuid())
  
  order       Int
  clue        String   // Hint to find the next step
  answer      String   // Expected QR code or answer
  
  huntId      String
  hunt        ScavengerHunt @relation(fields: [huntId], references: [id], onDelete: Cascade)
  
  workId      String?  // Optional: step is at this work
}

model ScavengerHuntParticipation {
  id          String   @id @default(uuid())
  
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  
  huntId      String
  hunt        ScavengerHunt @relation(fields: [huntId], references: [id], onDelete: Cascade)
  
  currentStep Int      @default(0)
  completed   Boolean  @default(false)
  completedAt DateTime?
  
  createdAt   DateTime @default(now())
  
  @@unique([visitorId, huntId])
}

// ========== FLOOR PLANS (MULTI-FLOOR MAPS) ==========

model FloorPlan {
  id        String   @id @default(uuid())
  name      String   // "Térreo", "1º Andar", etc
  floor     Int      @default(0) // 0 = térreo, 1, 2, etc
  imageUrl  String
  order     Int      @default(0) // Ordem de exibição no seletor
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([tenantId, order])
}

// ========== SERVICES REQUESTS ==========

model AccessibilityRequest {
  id          String   @id @default(uuid())
  
  type        String   // "LIBRAS", "AUDIO_DESC", "BOTH"
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  
  notes       String?  // Admin notes
  masterNotes String?  // Master response/notes
  
  workId      String
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  requestedBy String?  // User ID or Name/Email
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

// Push Notification Device Tokens
model DeviceToken {
  id        String   @id @default(uuid())
  token     String   @unique // FCM token
  platform  String   @default("web") // web, android, ios
  userAgent String?
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  
  tenantId  String?
  
  active    Boolean  @default(true)
  lastUsed  DateTime @default(now())
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([visitorId])
  @@index([active])
}

// ========== GESTÃO PÚBLICA CULTURAL ==========

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_EXECUTION
  COMPLETED
  CANCELED
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  INSCRIPTIONS_OPEN
  INSCRIPTIONS_CLOSED
  EVALUATION
  RESULTS_PUBLISHED
  FINISHED
}

enum AccessibilityServiceType {
  LIBRAS_INTERPRETATION
  AUDIO_DESCRIPTION
  CAPTIONING
  BRAILLE
  TACTILE_MODEL
  EASY_READING
}

// Edital Público
model PublicNotice {
  id               String       @id @default(uuid())
  title            String
  description      String?
  objectives       String?
  requirements     String?
  
  // Datas
  publishDate      DateTime?
  inscriptionStart DateTime
  inscriptionEnd   DateTime
  evaluationEnd    DateTime?
  resultsDate      DateTime?
  executionEnd     DateTime?
  
  // Valores
  totalBudget      Decimal?     @db.Decimal(12, 2)
  maxPerProject    Decimal?     @db.Decimal(10, 2)
  minPerProject    Decimal?     @db.Decimal(10, 2)
  
  // Categorização
  culturalCategories String[]
  targetRegions    String[]
  
  status           NoticeStatus @default(DRAFT)
  documentUrl      String?
  attachments      Json?
  
  requiresAccessibilityPlan Boolean @default(true)
  
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  projects         CulturalProject[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  
  @@index([tenantId, status])
  @@index([inscriptionEnd])
}

// Projeto Cultural
model CulturalProject {
  id               String        @id @default(uuid())
  title            String
  summary          String?
  description      String?
  justification    String?
  
  // Categorização
  culturalCategory String?
  targetRegion     String?
  targetAudience   String?
  
  // Cronograma
  startDate        DateTime?
  endDate          DateTime?
  
  // Financeiro
  requestedBudget  Decimal?      @db.Decimal(10, 2)
  approvedBudget   Decimal?      @db.Decimal(10, 2)
  
  // Metas
  expectedAudience Int?
  actualAudience   Int?
  
  status           ProjectStatus @default(DRAFT)
  
  // Documentos
  proposalUrl      String?
  attachments      Json?
  
  // Plano de Acessibilidade
  accessibilityPlan Json?
  
  // Vínculos
  noticeId         String?
  notice           PublicNotice? @relation(fields: [noticeId], references: [id])
  
  proponentId      String
  
  // Evento gerado a partir deste projeto (quando publicado na Agenda)
  eventId          String?

  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  accessibilityExecutions AccessibilityExecution[]
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  @@index([tenantId, status])
  @@index([noticeId])
  @@index([proponentId])
}

// Execução de Acessibilidade
model AccessibilityExecution {
  id               String                   @id @default(uuid())
  
  serviceType      AccessibilityServiceType
  
  // Solicitação
  requestedAt      DateTime                 @default(now())
  requestedBy      String?
  requestNotes     String?
  
  // Aprovação
  approvedAt       DateTime?
  approvedBy       String?
  approvedBudget   Decimal?                 @db.Decimal(8, 2)
  
  // Execução
  providerId       String?
  provider         AccessibilityProvider?   @relation(fields: [providerId], references: [id])
  
  executedAt       DateTime?
  executionNotes   String?
  deliverables     Json?
  
  // Validação
  validatedAt      DateTime?
  validatedBy      String?
  validationStatus String?
  validationNotes  String?
  
  status           String                   @default("PENDING")
  
  // Vínculos
  projectId        String?
  project          CulturalProject?         @relation(fields: [projectId], references: [id])
  
  eventId          String?
  
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  
  @@index([tenantId, status])
  @@index([projectId])
  @@index([providerId])
}

// Prestador de Acessibilidade
model AccessibilityProvider {
  id               String    @id @default(uuid())
  
  name             String
  document         String?
  email            String?
  phone            String?
  description      String?
  
  services         AccessibilityServiceType[]
  
  rating           Float?
  completedJobs    Int       @default(0)
  active           Boolean   @default(true)
  verifiedAt       DateTime?
  
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id])
  
  executions       AccessibilityExecution[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  @@index([active])
  @@index([tenantId])
}

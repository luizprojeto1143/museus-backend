  tenantId String

  activities PostVisitActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([teacherId])
}

model PostVisitActivity {
  id String @id @default(uuid())

  title       String
  description String?
  questions   Json? // Array of { question, type, options }
  ageGroup    String? // "6-8", "9-12", "13-17", "18+"
  workIds     String[] // Obras relacionadas

  autoSend Boolean   @default(true)
  sentAt   DateTime?

  schoolVisitId String?
  schoolVisit   SchoolVisit? @relation(fields: [schoolVisitId], references: [id])

  tenantId String

  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ========== PHASE 3 — MONETIZATION ==========

model TicketTransfer {
  id String @id @default(uuid())

  registrationId String

  fromEmail String
  toName    String
  toEmail   String

  newCode String @unique // Novo QR code

  status String @default("PENDING") // PENDING, COMPLETED, REJECTED

  transferredAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([registrationId])
}

model MembershipPlan {
  id String @id @default(uuid())

  name        String // "Amigo do Museu", "Patrono", etc
  description String?

  monthlyPrice Decimal  @db.Decimal(10, 2)
  yearlyPrice  Decimal? @db.Decimal(10, 2)

  benefits     Json? // Array of strings
  badgeCode    String? // Achievement code for members
  shopDiscount Int? // % de desconto na loja

  active Boolean @default(true)

  tenantId String

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Membership {
  id String @id @default(uuid())

  planId String
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  visitorEmail String
  visitorName  String

  status String @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED, EXPIRED

  startDate   DateTime  @default(now())
  renewDate   DateTime?
  cancelledAt DateTime?

  paymentId String?

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([visitorEmail])
}

// ========== PHASE 4 — MUNICIPAL ADVANCED ==========

model Volunteer {
  id String @id @default(uuid())

  name         String
  email        String
  phone        String?
  skills       String[]
  availability String? // "manhã", "tarde", "integral"

  status     String @default("ACTIVE") // ACTIVE, INACTIVE
  totalHours Float  @default(0)

  tenantId String

  shifts VolunteerShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, tenantId])
  @@index([tenantId])
}

model VolunteerShift {
  id String @id @default(uuid())

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  date      DateTime
  startTime String // "08:00"
  endTime   String // "12:00"
  hours     Float    @default(0)

  activity  String? // Descrição da atividade
  confirmed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([volunteerId])
}

model ConservationRecord {
  id String @id @default(uuid())

  workId String

  type            String // "LIMPEZA", "RESTAURO", "FUMIGACAO", "VISTORIA"
  description     String?
  responsibleName String

  condition   String? // "BOM", "REGULAR", "RUIM", "CRITICO"
  notes       String?
  attachments Json? // Array of file URLs (laudos PDF)

  performedAt   DateTime  @default(now())
  nextScheduled DateTime?

  tenantId String

  createdAt DateTime @default(now())

  @@index([workId])
  @@index([tenantId])
}

model WorkLoan {
  id String @id @default(uuid())

  workId String

  borrowerName    String // Instituição que recebeu
  borrowerContact String?

  purpose String? // "Exposição temporária", "Restauro externo"

  departureDate  DateTime
  expectedReturn DateTime?
  actualReturn   DateTime?

  status String @default("ACTIVE") // ACTIVE, RETURNED, OVERDUE

  conditions    String? // Condições do empréstimo
  insuranceInfo String?

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workId])
  @@index([tenantId])
}

model PPAGoal {
  id String @id @default(uuid())

  title       String
  description String?
  metric      String // "visitantes", "eventos", "projetos", etc

  targetValue  Int
  currentValue Int @default(0)

  year    Int
  quarter Int? // 1-4 (null = annual)

  status String @default("IN_PROGRESS") // IN_PROGRESS, ACHIEVED, MISSED

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, year])
}

// ========== PHASE 5 — GAMIFICATION, AI & i18n ==========

// Collectible Cards — digital trading cards for works
model CollectibleCard {
  id String @id @default(uuid())

  title       String
  description String?
  imageUrl    String?
  rarity      String  @default("COMMON") // COMMON, RARE, EPIC, LEGENDARY

  workId String? // Linked to a work (optional)

  totalMinted Int @default(100)

  xpReward Int @default(10)

  tenantId String

  owners VisitorCard[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([rarity])
}

// Visitor's card collection
model VisitorCard {
  id String @id @default(uuid())

  cardId String
  card   CollectibleCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  visitorId String

  earnedAt DateTime @default(now())

  @@unique([cardId, visitorId])
  @@index([visitorId])
}

// Review Moderation — AI-powered review moderation
model ReviewModeration {
  id String @id @default(uuid())

  reviewId String @unique

  isApproved Boolean?
  flagReason String? // "SPAM", "OFFENSIVE", "LOW_QUALITY", "OK"

  aiScore  Float? // 0-1 confidence
  aiReason String?

  moderatedBy String? // null = AI, user id = human
  moderatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([reviewId])
}

// Work Translations — multi-language support for artwork
model WorkTranslation {
  id String @id @default(uuid())

  workId String

  language    String // "en", "es", "fr", "de", "ja", etc
  title       String?
  description String?
  audioUrl    String? // TTS generated audio in target language

  isAutoGenerated Boolean @default(true)

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workId, language])
  @@index([tenantId])
}

// Museum Battle — competitive rankings between museums
model MuseumBattle {
  id String @id @default(uuid())

  month String // "2026-03"

  tenantId String

  totalVisitors Int   @default(0)
  totalEvents   Int   @default(0)
  totalReviews  Int   @default(0)
  avgRating     Float @default(0)

  score Int  @default(0) // Calculated composite score
  rank  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, month])
  @@index([month, score])
}

// ========== FINAL BATCH — Remaining Features ==========

// Intangible Heritage — patrimônio imaterial
model IntangibleHeritage {
  id String @id @default(uuid())

  title       String
  description String?
  category    String? // "FESTEJO", "SABER", "CELEBRACAO", "EXPRESSAO", "LUGAR"
  status      String  @default("ATIVO") // ATIVO, EM_ESTUDO, REGISTRADO

  imageUrl String?
  videoUrl String?

  holders String? // Detentores do saber
  region  String?

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Social Check-in
model SocialCheckin {
  id String @id @default(uuid())

  visitorId String
  tenantId  String

  message String?
  emoji   String? @default("🏛️")

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([visitorId])
}

// Group Ticket — checkout de grupo
model GroupTicket {
  id String @id @default(uuid())

  groupName    String
  totalTickets Int

  contactName  String
  contactEmail String
  contactPhone String?

  eventId String?

  status     String @default("PENDING") // PENDING, CONFIRMED, CANCELED
  totalPrice Float  @default(0)

  tenantId String

  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Base characters for visitors to choose from
model CharacterBase {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String
  active      Boolean  @default(true)
  tenantId    String?  // null = global character
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  visitorRPGs VisitorRPG[]
  skins       Skin[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// Visitor RPG — simple character evolution
model VisitorRPG {
  id String @id @default(uuid())

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  characterName  String @default("Explorador")
  characterClass String @default("NOVATO") // NOVATO, APRENDIZ, MESTRE, LENDA
  level          Int    @default(1)
  currentXp      Int    @default(0)
  nextLevelXp    Int    @default(100)

  totalVisits Int @default(0)
  totalWorks  Int @default(0)
  totalCards  Int @default(0)

  avatarUrl String?
  isActive  Boolean @default(false)

  selectedCharacterId String?
  selectedCharacter   CharacterBase? @relation(fields: [selectedCharacterId], references: [id])

  equippedSkinId String?
  equippedSkin   Skin? @relation(fields: [equippedSkinId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === NOVO: Sistema de Avatar com IA ===
  selfieUrl          String?   // URL da selfie original no R2
  baseAvatarUrl      String?   // URL do avatar cartoon gerado (sem skin)
  avatarStatus       String    @default("NONE") // NONE, GENERATING, READY, ERROR
  avatarGeneratedAt  DateTime? // quando o avatar base ficou pronto

  @@unique([visitorId, selectedCharacterId])
  @@index([level])
  @@index([visitorId])
}

// ========== ROADMAP MARÇO 2026 ==========

model CommunityPost {
  id         String  @id @default(uuid())
  content    String
  mediaUrl   String?
  status     String  @default("PENDING") // PENDING, APPROVED, REJECTED
  targetType String // "SPACE" | "WORK"
  targetId   String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([targetId])
}

model Quiz {
  id         String @id @default(uuid())
  title      String
  targetType String // "SPACE" | "WORK"
  targetId   String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([targetId])
}

model QuizQuestion {
  id           String @id @default(uuid())
  quizId       String
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question     String
  options      Json // Array of strings
  correctIndex Int
  xpReward     Int    @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimelineEvent {
  id          String  @id @default(uuid())
  spaceId     String
  space       Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  year        Int
  title       String
  description String?
  imageUrl    String?
  people      Json? // Array of objects { name, role }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
